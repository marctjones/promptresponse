<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      pdfe (https://github.com/marctjones/pdfe) — pure-managed, MIT-licensed
      PDF engine, consumed as a locally-packed NuGet package (see
      ../../local-nuget/README.md). MIT is GPL-3.0-compatible.
    -->
    <PackageReference Include="Excise.Core" Version="3.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PromptResponse.Core\PromptResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DejaVu Sans — embedded for PDF/A archival export (PDF/A forbids the
      non-embedded base-14 fonts) and to render arbitrary Unicode. Bitstream
      Vera / public-domain license (see Fonts/LICENSE-DejaVu.txt) — GPL-compatible.
    -->
    <EmbeddedResource Include="Fonts/DejaVuSans.ttf" />
    <!-- Ship the font license alongside the binaries (license must travel with distribution). -->
    <Content Include="Fonts/LICENSE-DejaVu.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
