<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Design Tokens for PromptResponse Modern UI
    Cross-platform compatible design system
    Supports Light/Dark themes with high accessibility standards
    -->

    <!-- Spacing System (8px base unit) -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space10">40</x:Double>
    <x:Double x:Key="Space12">48</x:Double>
    <x:Double x:Key="Space16">64</x:Double>

    <!-- Border Radius -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>

    <!-- Typography Scale -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeMedium">16</x:Double>
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeading">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>
    <x:Double x:Key="FontSizeHero">32</x:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- Elevation Shadows (Cross-platform compatible) -->
    <BoxShadows x:Key="ShadowSmall">0 1 3 0 #15000000</BoxShadows>
    <BoxShadows x:Key="ShadowMedium">0 2 8 0 #20000000</BoxShadows>
    <BoxShadows x:Key="ShadowLarge">0 4 16 0 #25000000</BoxShadows>
    <BoxShadows x:Key="ShadowXLarge">0 8 24 0 #30000000</BoxShadows>

    <!-- Animation Durations (Will respect reduced motion preference) -->
    <x:Double x:Key="AnimationDurationFast">150</x:Double>
    <x:Double x:Key="AnimationDurationNormal">250</x:Double>
    <x:Double x:Key="AnimationDurationSlow">350</x:Double>

    <!-- Light Theme Colors -->
    <Color x:Key="LightBackground">#FFFFFF</Color>
    <Color x:Key="LightBackgroundAlt">#F5F5F5</Color>
    <Color x:Key="LightBackgroundCard">#FFFFFF</Color>
    <Color x:Key="LightBorder">#E0E0E0</Color>
    <Color x:Key="LightBorderLight">#F0F0F0</Color>
    <Color x:Key="LightTextPrimary">#1A1A1A</Color>
    <Color x:Key="LightTextSecondary">#666666</Color>
    <Color x:Key="LightTextTertiary">#999999</Color>
    <Color x:Key="LightAccent">#0078D4</Color>
    <Color x:Key="LightAccentHover">#106EBE</Color>
    <Color x:Key="LightAccentPressed">#005A9E</Color>

    <!-- Dark Theme Colors -->
    <Color x:Key="DarkBackground">#1E1E1E</Color>
    <Color x:Key="DarkBackgroundAlt">#252525</Color>
    <Color x:Key="DarkBackgroundCard">#2D2D2D</Color>
    <Color x:Key="DarkBorder">#3F3F3F</Color>
    <Color x:Key="DarkBorderLight">#333333</Color>
    <Color x:Key="DarkTextPrimary">#FFFFFF</Color>
    <Color x:Key="DarkTextSecondary">#CCCCCC</Color>
    <Color x:Key="DarkTextTertiary">#999999</Color>
    <Color x:Key="DarkAccent">#4CC2FF</Color>
    <Color x:Key="DarkAccentHover">#6DD0FF</Color>
    <Color x:Key="DarkAccentPressed">#3AB4F0</Color>

    <!-- Semantic Colors (Status) -->
    <Color x:Key="ColorSuccess">#107C10</Color>
    <Color x:Key="ColorWarning">#FFA500</Color>
    <Color x:Key="ColorError">#D13438</Color>
    <Color x:Key="ColorInfo">#0078D4</Color>

    <!-- Light Theme Brushes -->
    <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackground}"/>
    <SolidColorBrush x:Key="LightBackgroundAltBrush" Color="{StaticResource LightBackgroundAlt}"/>
    <SolidColorBrush x:Key="LightBackgroundCardBrush" Color="{StaticResource LightBackgroundCard}"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="{StaticResource LightBorder}"/>
    <SolidColorBrush x:Key="LightBorderLightBrush" Color="{StaticResource LightBorderLight}"/>
    <SolidColorBrush x:Key="LightTextPrimaryBrush" Color="{StaticResource LightTextPrimary}"/>
    <SolidColorBrush x:Key="LightTextSecondaryBrush" Color="{StaticResource LightTextSecondary}"/>
    <SolidColorBrush x:Key="LightTextTertiaryBrush" Color="{StaticResource LightTextTertiary}"/>
    <SolidColorBrush x:Key="LightAccentBrush" Color="{StaticResource LightAccent}"/>
    <SolidColorBrush x:Key="LightAccentHoverBrush" Color="{StaticResource LightAccentHover}"/>
    <SolidColorBrush x:Key="LightAccentPressedBrush" Color="{StaticResource LightAccentPressed}"/>

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="DarkBackgroundAltBrush" Color="{StaticResource DarkBackgroundAlt}"/>
    <SolidColorBrush x:Key="DarkBackgroundCardBrush" Color="{StaticResource DarkBackgroundCard}"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="DarkBorderLightBrush" Color="{StaticResource DarkBorderLight}"/>
    <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/>
    <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondary}"/>
    <SolidColorBrush x:Key="DarkTextTertiaryBrush" Color="{StaticResource DarkTextTertiary}"/>
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccent}"/>
    <SolidColorBrush x:Key="DarkAccentHoverBrush" Color="{StaticResource DarkAccentHover}"/>
    <SolidColorBrush x:Key="DarkAccentPressedBrush" Color="{StaticResource DarkAccentPressed}"/>

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColorInfo}"/>

</ResourceDictionary>
