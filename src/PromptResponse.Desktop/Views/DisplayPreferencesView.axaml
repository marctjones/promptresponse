<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             x:Class="PromptResponse.Desktop.Views.DisplayPreferencesView"
             x:DataType="vm:DisplayPreferencesViewModel"
             AutomationProperties.Name="Display Preferences"
             AutomationProperties.HelpText="Pick a preset that matches your capabilities, or expand Customize to toggle individual features">
    <UserControl.Styles>
        <!-- Make checked rows visually distinct so the active state is scannable.
             Bold + accent foreground reads at a glance vs. the FluentTheme default
             where checked vs unchecked is a small box-state change. -->
        <Style Selector="CheckBox:checked">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="24" MaxWidth="720" HorizontalAlignment="Stretch">

            <TextBlock Text="Display Preferences"
                       FontSize="24" FontWeight="Bold"/>

            <TextBlock TextWrapping="Wrap"
                       Text="PromptResponse adapts to your capabilities. Pick a preset, or expand Customize to toggle every feature individually."/>

            <!-- Active enhancements summary — always visible at the top so users
                 can see what's on without scanning a long checkbox list. -->
            <Border BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Background="#10000000"
                    AutomationProperties.Name="Active enhancements"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Active enhancements" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="10"
                                Padding="8,1"
                                MinWidth="24"
                                IsVisible="{Binding ActiveCount}">
                            <TextBlock Text="{Binding ActiveCount}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveSummary}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Opacity="0.85"/>
                </StackPanel>
            </Border>

            <!-- ── Presets ── -->
            <StackPanel Spacing="8">
                <TextBlock Text="Preset" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                           Text="One-click compositions for common capability profiles. You can fine-tune any preset under Customize below."/>

                <Button x:Name="PresetExcellent"
                        Content="Excellent vision (default)"
                        Click="OnPresetExcellentClicked"
                        MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Excellent vision preset"
                        AutomationProperties.HelpText="Sighted user with no other accessibility needs; all visual affordances on"/>

                <Button x:Name="PresetBlind"
                        Content="Blind / screen reader"
                        Click="OnPresetBlindClicked"
                        MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Blind screen reader preset"
                        AutomationProperties.HelpText="Pure-text input; live input masks and calendar picker off so screen-reader speech isn't interrupted; commit-time masks and display previews stay on"/>

                <Button x:Name="PresetLowVision"
                        Content="Low vision / high contrast"
                        Click="OnPresetLowVisionClicked"
                        MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Low vision high contrast preset"
                        AutomationProperties.HelpText="High contrast color scheme, large text, large hit targets, all visual affordances on"/>

                <Button x:Name="PresetCognitive"
                        Content="Cognitive / dyslexia / executive-function"
                        Click="OnPresetCognitiveClicked"
                        MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Cognitive preset"
                        AutomationProperties.HelpText="Large text plus visual affordances. Future cognitive-specific features (dyslexia font, section focus mode) will be added to this preset when implemented"/>

                <Button x:Name="PresetMotor"
                        Content="Motor / mobility"
                        Click="OnPresetMotorClicked"
                        MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Motor mobility preset"
                        AutomationProperties.HelpText="Large hit targets and reduced motion. Future motor-specific features (hit-margin padding, voice-control names) will be added to this preset when implemented"/>
            </StackPanel>

            <!-- ── Customize: every flag individually ── -->
            <Expander Header="Customize individual features" IsExpanded="False"
                      AutomationProperties.Name="Customize features"
                      AutomationProperties.HelpText="Expand to toggle every feature flag independently of any preset">
                <StackPanel Spacing="20" Margin="0,12,0,0">

                    <!-- Color scheme (mutually exclusive) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Color scheme" FontWeight="SemiBold"/>
                        <RadioButton x:Name="LightRadio" Content="Light" GroupName="ColorScheme"
                                     IsChecked="{Binding IsLight, Mode=TwoWay}" MinHeight="36"
                                     AutomationProperties.Name="Light color scheme"
                                     AutomationProperties.HelpText="Bright background"/>
                        <RadioButton x:Name="DarkRadio" Content="Dark" GroupName="ColorScheme"
                                     IsChecked="{Binding IsDark, Mode=TwoWay}" MinHeight="36"
                                     AutomationProperties.Name="Dark color scheme"
                                     AutomationProperties.HelpText="Dim background; for photophobia, migraine sensitivity"/>
                        <RadioButton x:Name="HighContrastRadio" Content="High contrast" GroupName="ColorScheme"
                                     IsChecked="{Binding IsHighContrast, Mode=TwoWay}" MinHeight="36"
                                     AutomationProperties.Name="High contrast color scheme"
                                     AutomationProperties.HelpText="WCAG AAA; thick borders, no transparency"/>
                    </StackPanel>

                    <!-- Global -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Global enhancements" FontWeight="SemiBold"/>
                        <CheckBox x:Name="LargeTextCheck"
                                  Content="Large text (1.5×)" IsChecked="{Binding LargeText, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Large text"
                                  AutomationProperties.HelpText="Scales all text by 1.5×"/>
                        <CheckBox x:Name="ReducedMotionCheck"
                                  Content="Reduced motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Reduced motion"
                                  AutomationProperties.HelpText="Disables decorative animations and transitions"/>
                        <CheckBox x:Name="ScreenReaderTunedCheck"
                                  Content="Screen-reader tuned announcements" IsChecked="{Binding ScreenReaderTuned, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Screen-reader tuned announcements"
                                  AutomationProperties.HelpText="Verbose live regions for screen-reader users"/>
                        <CheckBox x:Name="LargeHitTargetsCheck"
                                  Content="Larger touch / click targets (56×56)" IsChecked="{Binding LargeHitTargets, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Large hit targets"
                                  AutomationProperties.HelpText="Tremor / switch / voice-control friendly"/>
                        <CheckBox x:Name="WizardModeCheck"
                                  Content="Wizard mode (one section at a time)" IsChecked="{Binding WizardMode, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Wizard mode"
                                  AutomationProperties.HelpText="Render forms section-by-section with Previous/Next navigation; reduces cognitive load on long forms"/>
                    </StackPanel>

                    <!-- Display rendering -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Display rendering" FontWeight="SemiBold"/>
                        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Reshapes how stored values are rendered. The underlying response stays raw."/>
                        <CheckBox x:Name="NumberThousandsSeparatorsCheck"
                                  Content="Number thousands separators (42,000)" IsChecked="{Binding NumberThousandsSeparators, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Number thousands separators"/>
                        <CheckBox x:Name="CurrencyDisplayCheck"
                                  Content="Currency display ($1,234.56)" IsChecked="{Binding CurrencyDisplay, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Currency display"/>
                        <CheckBox x:Name="IsoDatePrettifyCheck"
                                  Content="ISO date prettify (April 29, 2026)" IsChecked="{Binding IsoDatePrettify, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="ISO date prettify"/>
                        <CheckBox x:Name="DisplaysAsPreviewCheck"
                                  Content="'Displays as: …' preview line" IsChecked="{Binding DisplaysAsPreview, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Displays as preview"
                                  AutomationProperties.HelpText="Shows a polite live-region preview of how the value will be rendered"/>
                    </StackPanel>

                    <!-- Interactive widgets -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Interactive widgets" FontWeight="SemiBold"/>
                        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Auxiliary widgets alongside the universal text field. The text field is always available."/>
                        <CheckBox x:Name="CalendarPickerCheck"
                                  Content="Calendar picker on Date fields" IsChecked="{Binding CalendarPicker, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Calendar picker"/>
                        <CheckBox x:Name="BooleanRadiosCheck"
                                  Content="Yes/No radios on Boolean fields" IsChecked="{Binding BooleanRadios, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Boolean radios"/>
                    </StackPanel>

                    <!-- Input masks -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input masks" FontWeight="SemiBold"/>
                        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Reshape user-typed text for matching hint types. Free text always passes through."/>
                        <CheckBox x:Name="PhoneInputMaskCheck"
                                  Content="Phone — (555) 123-4567" IsChecked="{Binding PhoneInputMask, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Phone input mask"/>
                        <CheckBox x:Name="SsnInputMaskCheck"
                                  Content="SSN — ###-##-####" IsChecked="{Binding SsnInputMask, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="SSN input mask"/>
                        <CheckBox x:Name="EinInputMaskCheck"
                                  Content="EIN — ##-#######" IsChecked="{Binding EinInputMask, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="EIN input mask"/>
                        <CheckBox x:Name="ZipInputMaskCheck"
                                  Content="ZIP — #####-####" IsChecked="{Binding ZipInputMask, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="ZIP input mask"/>
                        <CheckBox x:Name="CurrencyInputMaskCheck"
                                  Content="Currency — $1,234.56 (commit)" IsChecked="{Binding CurrencyInputMask, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Currency input mask"/>
                        <CheckBox x:Name="PercentageInputMaskCheck"
                                  Content="Percentage — 12.5% (commit)" IsChecked="{Binding PercentageInputMask, Mode=TwoWay}" MinHeight="36"
                                  AutomationProperties.Name="Percentage input mask"/>
                    </StackPanel>

                </StackPanel>
            </Expander>

            <Button x:Name="ResetButton"
                    Content="Reset to system defaults"
                    Click="OnResetClicked"
                    MinHeight="36"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Reset display preferences"
                    AutomationProperties.HelpText="Clears all your toggles and restores OS-detected accessibility preferences"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
