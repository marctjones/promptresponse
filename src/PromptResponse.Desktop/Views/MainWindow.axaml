<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PromptResponse.Desktop.ViewModels"
        xmlns:views="using:PromptResponse.Desktop.Views"
        x:Class="PromptResponse.Desktop.Views.MainWindow"
        x:DataType="vm:MainShellViewModel"
        Icon="/Assets/app-icon.ico"
        Title="{Binding Title}"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="560"
        Background="{Binding ActiveProfileSurfaceBrush}"
        RequestedThemeVariant="{Binding ActiveThemeVariant}"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        ExtendClientAreaToDecorationsHint="False"
        AutomationProperties.Name="PromptResponse"
        AutomationProperties.HelpText="Form designer and filler workspace">
    <!--
      Thin window host. The full UI lives in MainShellView so it can be
      instantiated from headless GUI tests without a Window wrapper.

      TransparencyLevelHint sequence: Mica preferred (Win11), AcrylicBlur as
      a Win10/macOS fallback, then opaque. The hint is honoured by Avalonia
      where the OS supports it; on Linux it's a no-op and the bound
      ActiveProfileSurfaceBrush owns the appearance.
    -->
    <views:MainShellView/>
</Window>
