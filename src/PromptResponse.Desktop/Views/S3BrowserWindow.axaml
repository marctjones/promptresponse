<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PromptResponse.Desktop.ViewModels"
        x:Class="PromptResponse.Desktop.Views.S3BrowserWindow"
        x:DataType="vm:S3BrowserViewModel"
        Title="S3 Browser"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="S3 Browser Window"
        AutomationProperties.HelpText="Browse and download APR documents from S3 storage">

    <Design.DataContext>
        <vm:S3BrowserViewModel/>
    </Design.DataContext>

    <DockPanel Margin="20">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="S3 Browser"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}">
                Connect to an S3-compatible storage bucket to browse, download, and manage APR documents.
            </TextBlock>
        </StackPanel>

        <!-- Connection Settings -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel Spacing="10">
                <TextBlock Text="Connection Settings"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="150,*,10,150,*" RowDefinitions="Auto,Auto,Auto">
                    <!-- Service URL -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Service URL:"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                             Text="{Binding ServiceUrl}"
                             Watermark="http://localhost:9000"
                             AutomationProperties.Name="S3 Service URL"
                             AutomationProperties.HelpText="S3-compatible service URL (e.g., http://localhost:9000 for MinIO)"/>

                    <!-- Bucket Name and Region -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Bucket Name:"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding BucketName}"
                             Watermark="apr-forms"
                             AutomationProperties.Name="Bucket Name"
                             AutomationProperties.HelpText="Name of the S3 bucket"/>

                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="Region:"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="4"
                             Text="{Binding Region}"
                             Watermark="us-east-1"
                             AutomationProperties.Name="AWS Region"
                             AutomationProperties.HelpText="AWS region for the bucket"/>

                    <!-- Credentials -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Access Key ID:"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding AccessKeyId}"
                             Watermark="minioadmin"
                             AutomationProperties.Name="Access Key ID"
                             AutomationProperties.HelpText="AWS access key ID or MinIO username"/>

                    <TextBlock Grid.Row="2" Grid.Column="3"
                               Text="Secret Key:"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="4"
                             Text="{Binding SecretAccessKey}"
                             PasswordChar="*"
                             Watermark="********"
                             AutomationProperties.Name="Secret Access Key"
                             AutomationProperties.HelpText="AWS secret access key or MinIO password"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding ForcePathStyle}"
                              Content="Force Path Style (for MinIO)"
                              AutomationProperties.Name="Force Path Style"
                              AutomationProperties.HelpText="Use path-style URLs instead of virtual-hosted style"/>

                    <Button Content="Connect"
                            Command="{Binding TestConnectionCommand}"
                            Padding="20,8"
                            AutomationProperties.Name="Connect to S3"
                            AutomationProperties.HelpText="Test connection to the S3 bucket"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status Message -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,15"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas,Courier New,monospace"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <!-- Objects List -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15">
            <DockPanel>
                <!-- List Header -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Objects"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Prefix}"
                                 Watermark="Filter by prefix..."
                                 Width="200"
                                 AutomationProperties.Name="Object Prefix Filter"
                                 AutomationProperties.HelpText="Filter objects by key prefix"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="15,5"
                            Margin="0,0,10,0"
                            AutomationProperties.Name="Refresh Objects List"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                        <Button Content="Download"
                                Command="{Binding DownloadCommand}"
                                Padding="15,5"
                                AutomationProperties.Name="Download Selected Object"
                                AutomationProperties.HelpText="Download the selected APR document"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Padding="15,5"
                                AutomationProperties.Name="Delete Selected Object"
                                AutomationProperties.HelpText="Delete the selected object from S3"/>
                    </StackPanel>
                </Grid>

                <!-- Loading Indicator -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding IsLoading}"
                        Padding="10"
                        Margin="0,0,0,10">
                    <TextBlock Text="Loading..."
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Border>

                <!-- Objects DataGrid -->
                <DataGrid ItemsSource="{Binding Objects}"
                          SelectedItem="{Binding SelectedObject}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          AutomationProperties.Name="S3 Objects List">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Key}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Size"
                                            Binding="{Binding Size, StringFormat={}{0:N0} bytes}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Last Modified"
                                            Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
