<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             xmlns:converters="using:PromptResponse.Desktop.Converters"
             xmlns:behaviors="using:PromptResponse.Desktop.Behaviors"
             x:Class="PromptResponse.Desktop.Views.FormFillingView"
             x:DataType="vm:FormFillingViewModel">

    <UserControl.Resources>
        <converters:EqualsConverter x:Key="EqualsConverter"/>
        <converters:BooleanResponseConverter x:Key="BooleanResponseConverter"/>
        <converters:ContainsValueConverter x:Key="ContainsValueConverter"/>
        <converters:EqualsMultiConverter x:Key="EqualsMultiConverter"/>
        <converters:ContainsMultiConverter x:Key="ContainsMultiConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
        <converters:TimeSpanConverter x:Key="TimeSpanConverter"/>
        <converters:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter"/>
        <converters:ColorBrushConverter x:Key="ColorBrushConverter"/>
        <converters:ValidationIconConverter x:Key="ValidationIconConverter"/>
        <converters:ValidationColorConverter x:Key="ValidationColorConverter"/>
        <converters:ValidationTooltipConverter x:Key="ValidationTooltipConverter"/>
        <converters:ContainsConverter x:Key="ContainsConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:FormFillingViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="command-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left side: Save buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveCommand}"
                            Classes="modern-accent"
                            ToolTip.Tip="Save changes (Ctrl+S)"
                            AutomationProperties.Name="Save button">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                      Width="16" Height="16"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveAsCommand}"
                            Classes="modern"
                            ToolTip.Tip="Save as new file (Ctrl+Shift+S)"
                            AutomationProperties.Name="Save As button">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Width="16" Height="16"/>
                            <TextBlock Text="Save As..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SubmitToS3Command}"
                            Classes="modern"
                            ToolTip.Tip="{Binding SubmissionTooltip}"
                            IsEnabled="{Binding !IsSubmissionExpired}"
                            IsVisible="{Binding HasS3SubmissionConfig}"
                            AutomationProperties.Name="Submit to S3 button"
                            AutomationProperties.HelpText="{Binding SubmissionTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Cloud icon with status color -->
                            <PathIcon Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04M19,18H6A4,4 0 0,1 2,14C2,11.95 3.53,10.24 5.56,10.03L6.63,9.92L7.13,8.97C8.08,7.14 9.94,6 12,6C14.62,6 16.88,7.86 17.39,10.43L17.69,11.93L19.22,12.04C20.78,12.14 22,13.45 22,15A3,3 0 0,1 19,18M8,13H10.55V16H13.45V13H16L12,9L8,13Z"
                                      Width="16" Height="16">
                                <PathIcon.Styles>
                                    <Style Selector="PathIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </Style>
                                </PathIcon.Styles>
                            </PathIcon>
                            <TextBlock Text="{Binding SubmissionStatusText}" VerticalAlignment="Center"/>
                            <!-- Warning indicator for expiring soon -->
                            <TextBlock Text="⚠"
                                       FontSize="14"
                                       Foreground="#FFA500"
                                       IsVisible="{Binding IsSubmissionExpiringSoon}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Show disabled state message when no S3 config -->
                    <TextBlock Text="No S3 submission configured"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsVisible="{Binding !HasS3SubmissionConfig}"
                               AutomationProperties.Name="S3 submission not configured"/>

                    <!-- Check for Updates button - shown when template has a source URL -->
                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CheckForUpdatesCommand}"
                            Classes="modern"
                            ToolTip.Tip="Check if a newer version of this template is available"
                            IsVisible="{Binding HasTemplateSourceUrl}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Check for updates"
                            AutomationProperties.HelpText="Check if a newer version of this template is available from the original source">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Width="16" Height="16"/>
                            <TextBlock Text="Check for Updates" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Search panel -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding IsSearchVisible}"
                            AutomationProperties.Name="Search panel"
                            AutomationProperties.HelpText="Search for prompts by label, ID, or response text">
                    <TextBox Text="{Binding SearchText}"
                             Watermark="Search prompts..."
                             Width="250"
                             MinHeight="32"
                             Padding="8,4"
                             Name="SearchTextBox"
                             AutomationProperties.Name="Search prompts"
                             AutomationProperties.HelpText="Enter text to search for prompts by label, ID, or response"/>
                    <TextBlock Text="{Binding MatchStatusText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               MinWidth="80"
                               AutomationProperties.Name="Search match status"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button Command="{Binding PreviousMatchCommand}"
                            ToolTip.Tip="Previous match"
                            Width="28"
                            Height="28"
                            Padding="4"
                            AutomationProperties.Name="Previous search match"
                            AutomationProperties.HelpText="Navigate to the previous search result">
                        <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                  Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding NextMatchCommand}"
                            ToolTip.Tip="Next match (Enter)"
                            Width="28"
                            Height="28"
                            Padding="4"
                            AutomationProperties.Name="Next search match"
                            AutomationProperties.HelpText="Navigate to the next search result">
                        <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                  Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding ClearSearchCommand}"
                            ToolTip.Tip="Clear search"
                            Width="28"
                            Height="28"
                            Padding="4"
                            AutomationProperties.Name="Clear search"
                            AutomationProperties.HelpText="Clear the search text and results">
                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Width="12" Height="12"/>
                    </Button>
                </StackPanel>

                <!-- Right side: Search toggle button -->
                <Button Grid.Column="2"
                        Command="{Binding ToggleSearchCommand}"
                        Classes="modern"
                        ToolTip.Tip="Search prompts (Ctrl+F)"
                        AutomationProperties.Name="Toggle search"
                        AutomationProperties.HelpText="Show or hide the search panel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Classes="status-bar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>

                <!-- Progress tracking section -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="16,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Form completion progress"
                            AutomationProperties.HelpText="Shows how many prompts have been answered">
                    <ProgressBar Value="{Binding ProgressPercentage}"
                                 Minimum="0"
                                 Maximum="100"
                                 Width="100"
                                 Height="8"
                                 CornerRadius="4"
                                 AutomationProperties.Name="Progress bar"
                                 AutomationProperties.HelpText="{Binding ProgressText}"/>
                    <TextBlock Text="{Binding ProgressText}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource SystemBaseMediumHighColor}"
                               AutomationProperties.Name="Progress text"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Mode}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="{StaticResource FontWeightMedium}"
                           Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding SaveStateText}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource SystemAccentColor}"/>
            </Grid>
        </Border>

        <!-- Main content grid with sidebar -->
        <Grid ColumnDefinitions="*,Auto,250">
            <!-- Main content area -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          Name="MainScrollViewer">
                <Grid Margin="24">
                    <StackPanel HorizontalAlignment="Stretch" MaxWidth="1000">
                <!-- Form Header -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="{Binding Title}"
                               Classes="page-title"
                               AutomationProperties.Name="{Binding Title}"/>

                    <TextBlock Text="{Binding Description}"
                               FontSize="{StaticResource FontSizeMedium}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                               AutomationProperties.Name="Form Description"/>
                </StackPanel>

                <!-- Signature Information Banner -->
                <Border Margin="0,0,0,16"
                        Padding="16,12"
                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                        CornerRadius="6"
                        IsVisible="{Binding SignatureStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                        AutomationProperties.Name="Signature information">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SignatureStatusMessage}"
                                   Foreground="White"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding SignatureStatusMessage}"/>

                        <!-- Show template signature details if present -->
                        <ItemsControl ItemsSource="{Binding TemplateSignatures}"
                                      IsVisible="{Binding HasTemplateSignatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" Text="Template Publisher:"/>
                                        <TextBlock Foreground="White" FontSize="12">
                                            <Run Text="Name: "/>
                                            <Run Text="{Binding SignerName}" FontWeight="Medium"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="12" IsVisible="{Binding SignerOrganization, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Run Text="Organization: "/>
                                            <Run Text="{Binding SignerOrganization}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="12">
                                            <Run Text="Signed: "/>
                                            <Run Text="{Binding SignedAt, StringFormat='{}{0:g}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Show form signature details if present -->
                        <ItemsControl ItemsSource="{Binding FormSignatures}"
                                      IsVisible="{Binding HasFormSignatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" Text="Form Signer:"/>
                                        <TextBlock Foreground="White" FontSize="12">
                                            <Run Text="Name: "/>
                                            <Run Text="{Binding SignerName}" FontWeight="Medium"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="12" IsVisible="{Binding SignerEmail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Run Text="Email: "/>
                                            <Run Text="{Binding SignerEmail}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="12">
                                            <Run Text="Signed: "/>
                                            <Run Text="{Binding SignedAt, StringFormat='{}{0:g}'}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="11" Margin="0,4,0,0" FontWeight="SemiBold" Text="⚠ This form is read-only and cannot be edited" IsVisible="{Binding $parent[UserControl].((vm:FormFillingViewModel)DataContext).IsReadOnly}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            <!-- Sections -->
            <ItemsControl ItemsSource="{Binding Sections}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Form Sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="section-card"
                                HorizontalAlignment="Stretch"
                                Tag="{Binding}">
                            <Expander Classes="modern"
                                      IsExpanded="{Binding IsExpanded}"
                                      AutomationProperties.Name="{Binding Title}"
                                      AutomationProperties.HelpText="{Binding Description}"
                                      HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}"
                                                   Classes="section-title"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Margin="20,12,20,16" Spacing="8">
                                <!-- Child Sections -->
                                <ItemsControl ItemsSource="{Binding Sections}"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Margin="0,8,0,8"
                                                    Padding="0,0,0,12"
                                                    HorizontalAlignment="Stretch">
                                                <Expander IsExpanded="{Binding IsExpanded}"
                                                          AutomationProperties.Name="{Binding Title}"
                                                          HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="17"
                                                                   FontWeight="Medium"
                                                                   Margin="4,4"/>
                                                    </Expander.Header>

                                                    <StackPanel Margin="12,8,0,8" Spacing="16">
                                                        <!-- Child Section Description -->
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="4,0,0,8"
                                                                   IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                        <!-- Prompts in Subsection -->
                                                        <ItemsControl ItemsSource="{Binding Prompts}"
                                                                      HorizontalAlignment="Stretch">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   Classes="field-label"/>

                                                                        <!-- Smart controls (shown when UseSmartControl is true) -->
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              IsVisible="{Binding ShowSmartControl}">

                                                                            <!-- AutoCompleteBox for fields with suggested values (but NOT choice/multichoice) -->
                                                                            <AutoCompleteBox Grid.Column="0"
                                                                                             ItemsSource="{Binding SuggestedValues}"
                                                                                             Text="{Binding Response}"
                                                                                             Watermark="{Binding Placeholder}"
                                                                                             MinHeight="36"
                                                                                             AutomationProperties.Name="{Binding Label}"
                                                                                             AutomationProperties.HelpText="{Binding HelpText}"
                                                                                             TabIndex="0"
                                                                                             IsVisible="{Binding ShowAutocomplete}"/>

                                                                            <!-- Date field with text input and calendar picker -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto"
                                                                                  IsVisible="{Binding IsDateField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="{Binding Placeholder}"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Button Grid.Column="1"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnDatePickerClick"
                                                                                        Tag="{Binding}"
                                                                                        AutomationProperties.Name="Open calendar"
                                                                                        AutomationProperties.HelpText="Click to select a date from calendar">
                                                                                    <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                                                                              Width="16"
                                                                                              Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Radio buttons for choice fields (2-5 options) -->
                                                                            <ItemsControl Grid.Column="0"
                                                                                          ItemsSource="{Binding SuggestedValues}"
                                                                                          Tag="{Binding}"
                                                                                          IsVisible="{Binding UseRadioButtons}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:CompileBindings="False">
                                                                                        <RadioButton Content="{Binding}"
                                                                                                     Click="OnRadioButtonClick"
                                                                                                     Tag="{Binding}"
                                                                                                     Margin="0,4"
                                                                                                     AutomationProperties.Name="{Binding}">
                                                                                            <RadioButton.IsChecked>
                                                                                                <MultiBinding Converter="{StaticResource EqualsMultiConverter}" Mode="OneWay">
                                                                                                    <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Tag.Response"/>
                                                                                                    <Binding />
                                                                                                </MultiBinding>
                                                                                            </RadioButton.IsChecked>
                                                                                        </RadioButton>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <!-- Dropdown for choice fields (6+ options) -->
                                                                            <ComboBox Grid.Column="0"
                                                                                      ItemsSource="{Binding SuggestedValues}"
                                                                                      SelectedItem="{Binding Response}"
                                                                                      MinHeight="36"
                                                                                      AutomationProperties.Name="{Binding Label}"
                                                                                      AutomationProperties.HelpText="{Binding HelpText}"
                                                                                      IsVisible="{Binding UseDropdown}"/>

                                                                            <!-- Table field display - Fixed Table Grid -->
                                                                            <Border Grid.Column="0"
                                                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4"
                                                                                    Padding="8"
                                                                                    IsVisible="{Binding IsTableField}">
                                                                                <StackPanel Spacing="8">
                                                                                    <!-- Fixed Table -->
                                                                                    <StackPanel IsVisible="{Binding IsFixedTable}" Spacing="4">
                                                                                        <!-- Column Headers -->
                                                                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                                                CornerRadius="4"
                                                                                                Padding="4">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="120"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="" FontWeight="SemiBold" Margin="4,0"/>
                                                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding TableColumns}">
                                                                                                    <ItemsControl.ItemsPanel>
                                                                                                        <ItemsPanelTemplate>
                                                                                                            <UniformGrid Rows="1"/>
                                                                                                        </ItemsPanelTemplate>
                                                                                                    </ItemsControl.ItemsPanel>
                                                                                                    <ItemsControl.ItemTemplate>
                                                                                                        <DataTemplate>
                                                                                                            <TextBlock Text="{Binding Label}"
                                                                                                                       FontWeight="SemiBold"
                                                                                                                       FontSize="12"
                                                                                                                       HorizontalAlignment="Center"
                                                                                                                       Margin="4,0"/>
                                                                                                        </DataTemplate>
                                                                                                    </ItemsControl.ItemTemplate>
                                                                                                </ItemsControl>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <!-- Data Rows -->
                                                                                        <ItemsControl ItemsSource="{Binding TableRows}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                                            BorderThickness="0,0,0,1"
                                                                                                            Padding="4,6">
                                                                                                        <Grid>
                                                                                                            <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="120"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                            </Grid.ColumnDefinitions>
                                                                                                            <TextBlock Grid.Column="0"
                                                                                                                       Text="{Binding Label}"
                                                                                                                       FontWeight="Medium"
                                                                                                                       VerticalAlignment="Center"
                                                                                                                       Margin="4,0"/>
                                                                                                            <ItemsControl Grid.Column="1"
                                                                                                                          ItemsSource="{Binding Cells}">
                                                                                                                <ItemsControl.ItemsPanel>
                                                                                                                    <ItemsPanelTemplate>
                                                                                                                        <UniformGrid Rows="1"/>
                                                                                                                    </ItemsPanelTemplate>
                                                                                                                </ItemsControl.ItemsPanel>
                                                                                                                <ItemsControl.ItemTemplate>
                                                                                                                    <DataTemplate>
                                                                                                                        <TextBox Text="{Binding Value}"
                                                                                                                                 MinHeight="28"
                                                                                                                                 Margin="2,0"
                                                                                                                                 Padding="6,4"
                                                                                                                                 Watermark="{Binding Placeholder}"
                                                                                                                                 AutomationProperties.Name="{Binding ColumnLabel}"/>
                                                                                                                    </DataTemplate>
                                                                                                                </ItemsControl.ItemTemplate>
                                                                                                            </ItemsControl>
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>

                                                                                    <!-- Dynamic Table -->
                                                                                    <StackPanel IsVisible="{Binding IsDynamicTable}" Spacing="4">
                                                                                        <!-- Column Headers -->
                                                                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                                                CornerRadius="4"
                                                                                                Padding="4">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="100"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="36"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="" FontWeight="SemiBold" Margin="4,0"/>
                                                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding TableColumns}">
                                                                                                    <ItemsControl.ItemsPanel>
                                                                                                        <ItemsPanelTemplate>
                                                                                                            <UniformGrid Rows="1"/>
                                                                                                        </ItemsPanelTemplate>
                                                                                                    </ItemsControl.ItemsPanel>
                                                                                                    <ItemsControl.ItemTemplate>
                                                                                                        <DataTemplate>
                                                                                                            <TextBlock Text="{Binding Label}"
                                                                                                                       FontWeight="SemiBold"
                                                                                                                       FontSize="12"
                                                                                                                       HorizontalAlignment="Center"
                                                                                                                       Margin="4,0"/>
                                                                                                        </DataTemplate>
                                                                                                    </ItemsControl.ItemTemplate>
                                                                                                </ItemsControl>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <!-- Data Rows -->
                                                                                        <ItemsControl ItemsSource="{Binding TableRows}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                                            BorderThickness="0,0,0,1"
                                                                                                            Padding="4,6">
                                                                                                        <Grid>
                                                                                                            <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="100"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="36"/>
                                                                                                            </Grid.ColumnDefinitions>
                                                                                                            <TextBlock Grid.Column="0"
                                                                                                                       Text="{Binding Label}"
                                                                                                                       FontWeight="Medium"
                                                                                                                       VerticalAlignment="Center"
                                                                                                                       FontSize="11"
                                                                                                                       Margin="4,0"/>
                                                                                                            <ItemsControl Grid.Column="1"
                                                                                                                          ItemsSource="{Binding Cells}">
                                                                                                                <ItemsControl.ItemsPanel>
                                                                                                                    <ItemsPanelTemplate>
                                                                                                                        <UniformGrid Rows="1"/>
                                                                                                                    </ItemsPanelTemplate>
                                                                                                                </ItemsControl.ItemsPanel>
                                                                                                                <ItemsControl.ItemTemplate>
                                                                                                                    <DataTemplate>
                                                                                                                        <TextBox Text="{Binding Value}"
                                                                                                                                 MinHeight="28"
                                                                                                                                 Margin="2,0"
                                                                                                                                 Padding="6,4"
                                                                                                                                 Watermark="{Binding Placeholder}"
                                                                                                                                 AutomationProperties.Name="{Binding ColumnLabel}"/>
                                                                                                                    </DataTemplate>
                                                                                                                </ItemsControl.ItemTemplate>
                                                                                                            </ItemsControl>
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                        <!-- Add/Remove Row Buttons -->
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                                                            <Button Click="OnAddRowClick"
                                                                                                    Tag="{Binding}"
                                                                                                    IsEnabled="{Binding CanAddRow}"
                                                                                                    ToolTip.Tip="Add a new row"
                                                                                                    AutomationProperties.Name="Add row"
                                                                                                    AutomationProperties.HelpText="Add a new row to this table">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                                                                              Width="12" Height="12"/>
                                                                                                    <TextBlock Text="Add Row" FontSize="11"/>
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                            <Button Click="OnRemoveRowClick"
                                                                                                    Tag="{Binding}"
                                                                                                    IsEnabled="{Binding CanRemoveRow}"
                                                                                                    ToolTip.Tip="Remove the last row"
                                                                                                    AutomationProperties.Name="Remove row"
                                                                                                    AutomationProperties.HelpText="Remove the last row from this table">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                    <PathIcon Data="M19,13H5V11H19V13Z"
                                                                                                              Width="12" Height="12"/>
                                                                                                    <TextBlock Text="Remove Row" FontSize="11"/>
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                        </StackPanel>
                                                                                    </StackPanel>

                                                                                    <TextBlock Text="{Binding HelpText}"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                                               TextWrapping="Wrap"
                                                                                               IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- Single checkbox for boolean fields -->
                                                                            <CheckBox Grid.Column="0"
                                                                                      Content="{Binding Label}"
                                                                                      IsChecked="{Binding Response, Converter={StaticResource BooleanResponseConverter}, Mode=OneWay}"
                                                                                      Click="OnBooleanCheckBoxClick"
                                                                                      Tag="{Binding}"
                                                                                      MinHeight="36"
                                                                                      AutomationProperties.Name="{Binding Label}"
                                                                                      AutomationProperties.HelpText="{Binding HelpText}"
                                                                                      IsVisible="{Binding IsBooleanField}"/>

                                                                            <!-- Auto-formatted text input (phone, SSN, etc.) -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto"
                                                                                  IsVisible="{Binding IsFormattedField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="{Binding Placeholder}"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         behaviors:InputFormattingBehavior.IsEnabled="{Binding ShowSmartControl}"
                                                                                         behaviors:InputFormattingBehavior.DataType="{Binding ExpectedDataType}"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Button Grid.Column="1"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input"
                                                                                        AutomationProperties.HelpText="Click to use a simple text box instead of the smart control">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16"
                                                                                              Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Password field with masked input and show/hide toggle -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto"
                                                                                  IsVisible="{Binding IsPasswordField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="{Binding Placeholder}"
                                                                                         PasswordChar="●"
                                                                                         RevealPassword="{Binding ShowPassword}"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Button Grid.Column="1"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnTogglePasswordVisibility"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Show/hide password"
                                                                                        AutomationProperties.Name="Toggle password visibility">
                                                                                    <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Time picker -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto"
                                                                                  IsVisible="{Binding IsTimeField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="HH:MM:SS"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <TimePicker Grid.Column="1"
                                                                                            SelectedTime="{Binding Response, Converter={StaticResource TimeSpanConverter}}"
                                                                                            MinWidth="100"
                                                                                            Margin="4,0,0,0"
                                                                                            AutomationProperties.Name="{Binding Label}"/>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- DateTime picker -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto,Auto"
                                                                                  IsVisible="{Binding IsDateTimeField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="YYYY-MM-DD HH:MM:SS"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <CalendarDatePicker Grid.Column="1"
                                                                                                    SelectedDate="{Binding Response, Converter={StaticResource DateTimeConverter}}"
                                                                                                    MinWidth="120"
                                                                                                    Margin="4,0,0,0"
                                                                                                    AutomationProperties.Name="{Binding Label}"/>
                                                                                <TimePicker Grid.Column="2"
                                                                                            SelectedTime="{Binding Response, Converter={StaticResource DateTimeToTimeConverter}}"
                                                                                            MinWidth="100"
                                                                                            Margin="4,0,0,0"
                                                                                            AutomationProperties.Name="{Binding Label} time"/>
                                                                                <Button Grid.Column="3"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- File picker -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto"
                                                                                  IsVisible="{Binding IsFileField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="Click Browse to select a file"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         IsReadOnly="True"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Button Grid.Column="1"
                                                                                        Content="Browse..."
                                                                                        MinWidth="80"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnBrowseFileClick"
                                                                                        Tag="{Binding}"
                                                                                        AutomationProperties.Name="Browse for file"/>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Range slider -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="Auto,*,Auto,Auto"
                                                                                  IsVisible="{Binding IsRangeField}">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding RangeMin}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"/>
                                                                                <Slider Grid.Column="1"
                                                                                        Value="{Binding RangeValue}"
                                                                                        Minimum="{Binding RangeMin}"
                                                                                        Maximum="{Binding RangeMax}"
                                                                                        TickFrequency="{Binding RangeStep}"
                                                                                        IsSnapToTickEnabled="True"
                                                                                        MinHeight="36"
                                                                                        AutomationProperties.Name="{Binding Label}"
                                                                                        AutomationProperties.HelpText="{Binding HelpText}"/>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding Response}"
                                                                                           VerticalAlignment="Center"
                                                                                           FontWeight="Bold"
                                                                                           MinWidth="40"
                                                                                           TextAlignment="Center"
                                                                                           Margin="8,0"/>
                                                                                <Button Grid.Column="3"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Color picker -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="Auto,*,Auto"
                                                                                  IsVisible="{Binding IsColorField}">
                                                                                <Border Grid.Column="0"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        CornerRadius="4"
                                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                                        BorderThickness="1"
                                                                                        Background="{Binding Response, Converter={StaticResource ColorBrushConverter}}"
                                                                                        Margin="0,0,8,0"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="#RRGGBB or color name"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Email field with validation indicator -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto"
                                                                                  IsVisible="{Binding IsEmailField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="{Binding Placeholder}"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Border Grid.Column="1"
                                                                                        Width="24"
                                                                                        Height="24"
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        ToolTip.Tip="{Binding IsValidEmail, Converter={StaticResource ValidationTooltipConverter}}">
                                                                                    <PathIcon Data="{Binding IsValidEmail, Converter={StaticResource ValidationIconConverter}}"
                                                                                              Foreground="{Binding IsValidEmail, Converter={StaticResource ValidationColorConverter}}"
                                                                                              Width="16" Height="16"/>
                                                                                </Border>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- URL field with validation indicator -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto"
                                                                                  IsVisible="{Binding IsUrlField}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="{Binding Placeholder}"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Border Grid.Column="1"
                                                                                        Width="24"
                                                                                        Height="24"
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        ToolTip.Tip="{Binding IsValidUrl, Converter={StaticResource ValidationTooltipConverter}}">
                                                                                    <PathIcon Data="{Binding IsValidUrl, Converter={StaticResource ValidationIconConverter}}"
                                                                                              Foreground="{Binding IsValidUrl, Converter={StaticResource ValidationColorConverter}}"
                                                                                              Width="16" Height="16"/>
                                                                                </Border>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Signature capture field -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto"
                                                                                  IsVisible="{Binding IsSignatureField}">
                                                                                <Border Grid.Column="0"
                                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="4"
                                                                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                                                        MinHeight="80"
                                                                                        Padding="8">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="Type your full legal name as signature:"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                                                   Margin="0,0,0,4"/>
                                                                                        <TextBox Text="{Binding Response}"
                                                                                                 FontFamily="Segoe Script, Brush Script MT, cursive"
                                                                                                 FontSize="20"
                                                                                                 FontStyle="Italic"
                                                                                                 Watermark="Type your signature here"
                                                                                                 MinHeight="36"
                                                                                                 AutomationProperties.Name="{Binding Label}"
                                                                                                 AutomationProperties.HelpText="Type your full legal name as an electronic signature"/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <Button Grid.Column="1"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Top"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Multichoice checkboxes -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto"
                                                                                  IsVisible="{Binding IsMultichoiceField}">
                                                                                <ItemsControl Grid.Column="0"
                                                                                              ItemsSource="{Binding SuggestedValues}"
                                                                                              Tag="{Binding}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <CheckBox Content="{Binding}"
                                                                                                      Click="OnMultiChoiceCheckBoxClick"
                                                                                                      Tag="{Binding}"
                                                                                                      Margin="0,2"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Button Grid.Column="1"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Top"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <!-- Pattern validation field -->
                                                                            <Grid Grid.Column="0"
                                                                                  ColumnDefinitions="*,Auto,Auto"
                                                                                  IsVisible="{Binding HasValidationPattern}">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Response}"
                                                                                         Watermark="{Binding Placeholder}"
                                                                                         MinHeight="36"
                                                                                         Padding="10,8"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                                                         TabIndex="0"/>
                                                                                <Border Grid.Column="1"
                                                                                        Width="24"
                                                                                        Height="24"
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        ToolTip.Tip="{Binding IsValidPattern, Converter={StaticResource ValidationTooltipConverter}}">
                                                                                    <PathIcon Data="{Binding IsValidPattern, Converter={StaticResource ValidationIconConverter}}"
                                                                                              Foreground="{Binding IsValidPattern, Converter={StaticResource ValidationColorConverter}}"
                                                                                              Width="16" Height="16"/>
                                                                                </Border>
                                                                                <Button Grid.Column="2"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        Margin="4,0,0,0"
                                                                                        Click="OnToggleSmartControlClick"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip.Tip="Switch to plain text input"
                                                                                        AutomationProperties.Name="Switch to plain text input">
                                                                                    <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                                              Width="16" Height="16"/>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Grid>

                                                                        <!-- Plain TextBox (shown when UseSmartControl is false or no smart control available) -->
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              IsVisible="{Binding ShowPlainTextBox}">
                                                                            <TextBox Grid.Column="0"
                                                                                     Text="{Binding Response}"
                                                                                     Watermark="{Binding Placeholder}"
                                                                                     MinHeight="36"
                                                                                     Padding="10,8"
                                                                                     AcceptsReturn="{Binding UseMultilineTextBox}"
                                                                                     TextWrapping="Wrap"
                                                                                     AutomationProperties.Name="{Binding Label}"
                                                                                     AutomationProperties.HelpText="{Binding HelpText}"
                                                                                     TabIndex="0"/>

                                                                            <!-- Toggle button to switch back to smart control (only shown if smart control is available) -->
                                                                            <Button Grid.Column="1"
                                                                                    Width="36"
                                                                                    Height="36"
                                                                                    Margin="4,0,0,0"
                                                                                    Click="OnToggleSmartControlClick"
                                                                                    Tag="{Binding}"
                                                                                    ToolTip.Tip="Switch to smart control"
                                                                                    AutomationProperties.Name="Switch to smart control"
                                                                                    AutomationProperties.HelpText="Click to use the smart control with suggestions or date picker"
                                                                                    IsVisible="{Binding HasSmartControl}">
                                                                                <PathIcon Data="M12,2C17.52,2 22,6.48 22,12C22,17.52 17.52,22 12,22C6.48,22 2,17.52 2,12C2,6.48 6.48,2 12,2M12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20M16.59,7.58L10,14.17L7.41,11.59L6,13L10,17L18,9L16.59,7.58Z"
                                                                                          Width="16"
                                                                                          Height="16"/>
                                                                            </Button>
                                                                        </Grid>

                                                                        <TextBlock Text="{Binding HelpText}"
                                                                                   Classes="help-text"
                                                                                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                   AutomationProperties.LiveSetting="Polite"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Section-level Prompts -->
                                <ItemsControl ItemsSource="{Binding Prompts}"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Label}"
                                                           Classes="field-label"/>

                                                <!-- Smart controls (shown when UseSmartControl is true) -->
                                                <Grid ColumnDefinitions="*,Auto"
                                                      IsVisible="{Binding ShowSmartControl}">

                                                    <!-- AutoCompleteBox for fields with suggested values (but NOT choice/multichoice) -->
                                                    <AutoCompleteBox Grid.Column="0"
                                                                     ItemsSource="{Binding SuggestedValues}"
                                                                     Text="{Binding Response}"
                                                                     Watermark="{Binding Placeholder}"
                                                                     MinHeight="36"
                                                                     AutomationProperties.Name="{Binding Label}"
                                                                     AutomationProperties.HelpText="{Binding HelpText}"
                                                                     TabIndex="0"
                                                                     IsVisible="{Binding ShowAutocomplete}"/>

                                                    <!-- Date field with text input and calendar picker -->
                                                    <Grid Grid.Column="0"
                                                          ColumnDefinitions="*,Auto"
                                                          IsVisible="{Binding IsDateField}">
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Response}"
                                                                 Watermark="{Binding Placeholder}"
                                                                 MinHeight="36"
                                                                 Padding="10,8"
                                                                 AutomationProperties.Name="{Binding Label}"
                                                                 AutomationProperties.HelpText="{Binding HelpText}"
                                                                 TabIndex="0"/>
                                                        <Button Grid.Column="1"
                                                                Width="36"
                                                                Height="36"
                                                                Margin="4,0,0,0"
                                                                Click="OnDatePickerClick"
                                                                Tag="{Binding}"
                                                                AutomationProperties.Name="Open calendar"
                                                                AutomationProperties.HelpText="Click to select a date from calendar">
                                                            <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                                                      Width="16"
                                                                      Height="16"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Radio buttons for choice fields (2-5 options) -->
                                                    <ItemsControl Grid.Column="0"
                                                                  ItemsSource="{Binding SuggestedValues}"
                                                                  Tag="{Binding}"
                                                                  IsVisible="{Binding UseRadioButtons}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:CompileBindings="False">
                                                                <RadioButton Content="{Binding}"
                                                                             Click="OnRadioButtonClick"
                                                                             Tag="{Binding}"
                                                                             Margin="0,4"
                                                                             AutomationProperties.Name="{Binding}">
                                                                    <RadioButton.IsChecked>
                                                                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}" Mode="OneWay">
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Tag.Response"/>
                                                                            <Binding />
                                                                        </MultiBinding>
                                                                    </RadioButton.IsChecked>
                                                                </RadioButton>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Dropdown for choice fields (6+ options) -->
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding SuggestedValues}"
                                                              SelectedItem="{Binding Response}"
                                                              MinHeight="36"
                                                              AutomationProperties.Name="{Binding Label}"
                                                              AutomationProperties.HelpText="{Binding HelpText}"
                                                              IsVisible="{Binding UseDropdown}"/>

                                                    <!-- Table field display - Fixed Table Grid -->
                                                    <Border Grid.Column="0"
                                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8"
                                                            IsVisible="{Binding IsTableField}">
                                                        <StackPanel Spacing="8">
                                                            <!-- Fixed Table -->
                                                            <StackPanel IsVisible="{Binding IsFixedTable}" Spacing="4">
                                                                <!-- Column Headers -->
                                                                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="120"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="" FontWeight="SemiBold" Margin="4,0"/>
                                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TableColumns}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <UniformGrid Rows="1"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Label}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="12"
                                                                                               HorizontalAlignment="Center"
                                                                                               Margin="4,0"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Data Rows -->
                                                                <ItemsControl ItemsSource="{Binding TableRows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    BorderThickness="0,0,0,1"
                                                                                    Padding="4,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="120"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Label}"
                                                                                               FontWeight="Medium"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="4,0"/>
                                                                                    <ItemsControl Grid.Column="1"
                                                                                                  ItemsSource="{Binding Cells}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <UniformGrid Rows="1"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBox Text="{Binding Value}"
                                                                                                         MinHeight="28"
                                                                                                         Margin="2,0"
                                                                                                         Padding="6,4"
                                                                                                         Watermark="{Binding Placeholder}"
                                                                                                         AutomationProperties.Name="{Binding ColumnLabel}"/>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <!-- Dynamic Table -->
                                                            <StackPanel IsVisible="{Binding IsDynamicTable}" Spacing="4">
                                                                <!-- Column Headers -->
                                                                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="36"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="" FontWeight="SemiBold" Margin="4,0"/>
                                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TableColumns}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <UniformGrid Rows="1"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Label}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="12"
                                                                                               HorizontalAlignment="Center"
                                                                                               Margin="4,0"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Data Rows -->
                                                                <ItemsControl ItemsSource="{Binding TableRows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    BorderThickness="0,0,0,1"
                                                                                    Padding="4,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="100"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="36"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Label}"
                                                                                               FontWeight="Medium"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="11"
                                                                                               Margin="4,0"/>
                                                                                    <ItemsControl Grid.Column="1"
                                                                                                  ItemsSource="{Binding Cells}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <UniformGrid Rows="1"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBox Text="{Binding Value}"
                                                                                                         MinHeight="28"
                                                                                                         Margin="2,0"
                                                                                                         Padding="6,4"
                                                                                                         Watermark="{Binding Placeholder}"
                                                                                                         AutomationProperties.Name="{Binding ColumnLabel}"/>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <!-- Add/Remove Row Buttons -->
                                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                                    <Button Click="OnAddRowClick"
                                                                            Tag="{Binding}"
                                                                            IsEnabled="{Binding CanAddRow}"
                                                                            ToolTip.Tip="Add a new row"
                                                                            AutomationProperties.Name="Add row"
                                                                            AutomationProperties.HelpText="Add a new row to this table">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                                                      Width="12" Height="12"/>
                                                                            <TextBlock Text="Add Row" FontSize="11"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Click="OnRemoveRowClick"
                                                                            Tag="{Binding}"
                                                                            IsEnabled="{Binding CanRemoveRow}"
                                                                            ToolTip.Tip="Remove the last row"
                                                                            AutomationProperties.Name="Remove row"
                                                                            AutomationProperties.HelpText="Remove the last row from this table">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <PathIcon Data="M19,13H5V11H19V13Z"
                                                                                      Width="12" Height="12"/>
                                                                            <TextBlock Text="Remove Row" FontSize="11"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding HelpText}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Single checkbox for boolean fields -->
                                                    <CheckBox Grid.Column="0"
                                                              Content="{Binding Label}"
                                                              IsChecked="{Binding Response, Converter={StaticResource BooleanResponseConverter}, Mode=OneWay}"
                                                              Click="OnBooleanCheckBoxClick"
                                                              Tag="{Binding}"
                                                              MinHeight="36"
                                                              AutomationProperties.Name="{Binding Label}"
                                                              AutomationProperties.HelpText="{Binding HelpText}"
                                                              IsVisible="{Binding IsBooleanField}"/>

                                                    <!-- Auto-formatted text input (phone, SSN, etc.) -->
                                                    <Grid Grid.Column="0"
                                                          ColumnDefinitions="*,Auto"
                                                          IsVisible="{Binding IsFormattedField}">
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Response}"
                                                                 Watermark="{Binding Placeholder}"
                                                                 MinHeight="36"
                                                                 Padding="10,8"
                                                                 behaviors:InputFormattingBehavior.IsEnabled="{Binding ShowSmartControl}"
                                                                 behaviors:InputFormattingBehavior.DataType="{Binding ExpectedDataType}"
                                                                 AutomationProperties.Name="{Binding Label}"
                                                                 AutomationProperties.HelpText="{Binding HelpText}"
                                                                 TabIndex="0"/>
                                                        <Button Grid.Column="1"
                                                                Width="36"
                                                                Height="36"
                                                                Margin="4,0,0,0"
                                                                Click="OnToggleSmartControlClick"
                                                                Tag="{Binding}"
                                                                ToolTip.Tip="Switch to plain text input"
                                                                AutomationProperties.Name="Switch to plain text input"
                                                                AutomationProperties.HelpText="Click to use a simple text box instead of the smart control">
                                                            <PathIcon Data="M5,3C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"
                                                                      Width="16"
                                                                      Height="16"/>
                                                        </Button>
                                                    </Grid>
                                                </Grid>

                                                <!-- Plain TextBox (shown when UseSmartControl is false or no smart control available) -->
                                                <Grid ColumnDefinitions="*,Auto"
                                                      IsVisible="{Binding ShowPlainTextBox}">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Response}"
                                                             Watermark="{Binding Placeholder}"
                                                             MinHeight="36"
                                                             Padding="10,8"
                                                             AcceptsReturn="{Binding UseMultilineTextBox}"
                                                             TextWrapping="Wrap"
                                                             AutomationProperties.Name="{Binding Label}"
                                                             AutomationProperties.HelpText="{Binding HelpText}"
                                                             TabIndex="0"/>

                                                    <!-- Toggle button to switch back to smart control (only shown if smart control is available) -->
                                                    <Button Grid.Column="1"
                                                            Width="36"
                                                            Height="36"
                                                            Margin="4,0,0,0"
                                                            Click="OnToggleSmartControlClick"
                                                            Tag="{Binding}"
                                                            ToolTip.Tip="Switch to smart control"
                                                            AutomationProperties.Name="Switch to smart control"
                                                            AutomationProperties.HelpText="Click to use the smart control with suggestions or date picker"
                                                            IsVisible="{Binding HasSmartControl}">
                                                        <PathIcon Data="M12,2C17.52,2 22,6.48 22,12C22,17.52 17.52,22 12,22C6.48,22 2,17.52 2,12C2,6.48 6.48,2 12,2M12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20M16.59,7.58L10,14.17L7.41,11.59L6,13L10,17L18,9L16.59,7.58Z"
                                                                  Width="16"
                                                                  Height="16"/>
                                                    </Button>
                                                </Grid>

                                                <TextBlock Text="{Binding HelpText}"
                                                           Classes="help-text"
                                                           IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Sidebar separator -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Section navigation sidebar -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sections"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource SystemBaseMediumHighColor}"/>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}"
                                            Tag="{Binding}"
                                            Click="OnSectionNavigationClick"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6"
                                            Margin="0,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Foreground="{DynamicResource SystemBaseMediumHighColor}"
                                            ToolTip.Tip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Navigate to section: {0}'}"
                                            AutomationProperties.HelpText="Click to scroll to this section in the form">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
                                            </Style>
                                            <Style Selector="Button:focus">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
