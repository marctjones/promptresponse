<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             x:Class="PromptResponse.Desktop.Views.FormFillingView"
             x:DataType="vm:FormFillingViewModel">

    <Design.DataContext>
        <vm:FormFillingViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveCommand}"
                        Content="💾 Save"
                        Padding="12,6"
                        ToolTip.Tip="Save changes (Ctrl+S)"
                        AutomationProperties.Name="Save button"/>
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveAsCommand}"
                        Content="Save As..."
                        Padding="12,6"
                        ToolTip.Tip="Save as new file (Ctrl+Shift+S)"
                        AutomationProperties.Name="Save As button"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Mode}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SaveStateText}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemAccentColor}"/>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <StackPanel HorizontalAlignment="Stretch" MaxWidth="1000">
                <!-- Form Header (Simplified - no orange bar!) -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="{Binding Title}"
                               FontSize="28"
                               FontWeight="Bold"
                               AutomationProperties.Name="{Binding Title}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding Description}"
                               FontSize="15"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                               AutomationProperties.Name="Form Description"/>
                </StackPanel>

            <!-- Sections -->
            <ItemsControl ItemsSource="{Binding Sections}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Form Sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,16"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                HorizontalAlignment="Stretch">
                            <Expander IsExpanded="{Binding IsExpanded}"
                                      AutomationProperties.Name="{Binding Title}"
                                      AutomationProperties.HelpText="{Binding Description}"
                                      HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Margin="4,8">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Margin="20,12,20,16" Spacing="8">
                                <!-- Subsections -->
                                <ItemsControl ItemsSource="{Binding Subsections}"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Margin="0,8,0,8"
                                                    Padding="0,0,0,12"
                                                    HorizontalAlignment="Stretch">
                                                <Expander IsExpanded="{Binding IsExpanded}"
                                                          AutomationProperties.Name="{Binding Title}"
                                                          HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="17"
                                                                   FontWeight="Medium"
                                                                   Margin="4,4"/>
                                                    </Expander.Header>

                                                    <StackPanel Margin="12,8,0,8" Spacing="16">
                                                        <!-- Prompts in Subsection -->
                                                        <ItemsControl ItemsSource="{Binding Prompts}"
                                                                      HorizontalAlignment="Stretch">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontWeight="Medium"
                                                                                   FontSize="14"/>

                                                                        <TextBox Text="{Binding Response}"
                                                                                 Watermark="{Binding Placeholder}"
                                                                                 MinHeight="36"
                                                                                 Padding="10,8"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 AutomationProperties.Name="{Binding Label}"
                                                                                 AutomationProperties.HelpText="{Binding HelpText}"
                                                                                 TabIndex="0"/>

                                                                        <TextBlock Text="{Binding HelpText}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SystemBaseMediumLowColor}"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                   AutomationProperties.LiveSetting="Polite"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Section-level Prompts -->
                                <ItemsControl ItemsSource="{Binding Prompts}"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="Medium"
                                                           FontSize="14"/>

                                                <TextBox Text="{Binding Response}"
                                                         Watermark="{Binding Placeholder}"
                                                         MinHeight="36"
                                                         Padding="10,8"
                                                         HorizontalAlignment="Stretch"
                                                         AutomationProperties.Name="{Binding Label}"
                                                         AutomationProperties.HelpText="{Binding HelpText}"
                                                         TabIndex="0"/>

                                                <TextBlock Text="{Binding HelpText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SystemBaseMediumLowColor}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>

</UserControl>
