<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmp="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Editor.PromptEditorView"
             x:DataType="vmp:PromptViewModelBase">
    <Border BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Margin="0,2">
        <StackPanel Spacing="8">
            <!-- Top row: drag handle + label + type + remove -->
            <Grid ColumnDefinitions="Auto,8,*,8,180,8,Auto">
                <Border Grid.Column="0"
                        x:Name="DragHandle"
                        VerticalAlignment="Center"
                        Padding="6,4"
                        Cursor="SizeAll"
                        Background="Transparent"
                        ToolTip.Tip="Drag to reorder"
                        AutomationProperties.Name="Drag to reorder prompt">
                    <TextBlock Text="⋮⋮"
                               FontSize="14"
                               Opacity="0.6"
                               IsHitTestVisible="False"/>
                </Border>

                <TextBox Grid.Column="2"
                         Text="{Binding Label, Mode=TwoWay}"
                         PlaceholderText="Prompt label (required)"
                         FontWeight="SemiBold"
                         AutomationProperties.Name="Prompt label"
                         AutomationProperties.HelpText="The user-visible label shown to whoever fills this form"/>

                <ComboBox Grid.Column="4"
                          SelectedItem="{Binding ExpectedDataType, Mode=TwoWay}"
                          PlaceholderText="(no type hint)"
                          AutomationProperties.Name="Expected data type"
                          AutomationProperties.HelpText="Advisory hint — any text is still a valid response">
                    <ComboBoxItem>text</ComboBoxItem>
                    <ComboBoxItem>multiline</ComboBoxItem>
                    <ComboBoxItem>number</ComboBoxItem>
                    <ComboBoxItem>currency</ComboBoxItem>
                    <ComboBoxItem>date</ComboBoxItem>
                    <ComboBoxItem>datetime</ComboBoxItem>
                    <ComboBoxItem>time</ComboBoxItem>
                    <ComboBoxItem>email</ComboBoxItem>
                    <ComboBoxItem>url</ComboBoxItem>
                    <ComboBoxItem>phone</ComboBoxItem>
                    <ComboBoxItem>boolean</ComboBoxItem>
                    <ComboBoxItem>signature</ComboBoxItem>
                    <ComboBoxItem>file</ComboBoxItem>
                </ComboBox>

                <Button Grid.Column="6"
                        Content="✕"
                        FontSize="11"
                        Padding="6,2"
                        MinHeight="28"
                        MinWidth="28"
                        ToolTip.Tip="Remove this prompt"
                        AutomationProperties.Name="Remove prompt"
                        Click="OnRemoveClick"/>
            </Grid>

            <!-- Hints expander: optional fields -->
            <Expander Header="Hints (placeholder, help text, validation)"
                      AutomationProperties.Name="Prompt hints"
                      AutomationProperties.HelpText="Optional advisory hints for placeholder, help text, and pattern">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                    <TextBox Text="{Binding Placeholder, Mode=TwoWay}"
                             PlaceholderText="Placeholder text shown when the field is empty"
                             AutomationProperties.Name="Placeholder text"/>
                    <TextBox Text="{Binding HelpText, Mode=TwoWay}"
                             PlaceholderText="Help text — additional guidance shown beneath the field"
                             AutomationProperties.Name="Help text"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="48"/>
                    <TextBox Text="{Binding ValidationPattern, Mode=TwoWay}"
                             PlaceholderText="Optional regex (advisory only — never blocks)"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             AutomationProperties.Name="Validation pattern"
                             AutomationProperties.HelpText="Optional regex pattern. Hint only — does not block free-text input."/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
