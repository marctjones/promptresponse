<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             xmlns:editor="using:PromptResponse.Desktop.Views.Editor"
             x:Class="PromptResponse.Desktop.Views.Editor.SectionEditorView"
             x:DataType="vm:SectionViewModel"
             AutomationProperties.Name="{Binding Title}"
             AutomationProperties.HelpText="{Binding Description}">

    <Border BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,4">
        <StackPanel Spacing="10">
            <!-- Section title + description editors + structural buttons -->
            <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                <Border Grid.Column="0"
                        x:Name="SectionDragHandle"
                        VerticalAlignment="Center"
                        Padding="6,4"
                        Cursor="SizeAll"
                        Background="Transparent"
                        ToolTip.Tip="Drag to reorder this section"
                        AutomationProperties.Name="Drag to reorder section">
                    <TextBlock Text="⋮⋮"
                               FontSize="14"
                               Opacity="0.6"
                               IsHitTestVisible="False"/>
                </Border>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBox Text="{Binding Title, Mode=TwoWay}"
                             PlaceholderText="Section title (required)"
                             FontSize="16"
                             FontWeight="SemiBold"
                             AutomationProperties.Name="Section title"/>
                    <TextBox Text="{Binding Description, Mode=TwoWay}"
                             PlaceholderText="Optional description"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="36"
                             AutomationProperties.Name="Section description"/>
                </StackPanel>

                <!-- Remove section button. Click handler walks the visual tree to
                     find the parent (a nested section's parent SectionViewModel, or
                     the shell for top-level sections) and dispatches the appropriate
                     remove command. -->
                <Button Grid.Column="4"
                        Content="✕ Remove section"
                        VerticalAlignment="Top"
                        Padding="8,4"
                        ToolTip.Tip="Remove this section and all of its prompts"
                        AutomationProperties.Name="Remove section"
                        Click="OnRemoveSectionClick"/>
            </Grid>

            <!-- ── Regular section: prompts list + add buttons ── -->
            <StackPanel IsVisible="{Binding IsRegularSection}" Spacing="6">
                <ItemsControl x:Name="PromptsList"
                              ItemsSource="{Binding PromptViewModels}"
                              AutomationProperties.Name="Section prompts">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <editor:PromptEditorView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="+ Add prompt"
                            Command="{Binding AddPromptCommand}"
                            AutomationProperties.Name="Add prompt"
                            AutomationProperties.HelpText="Append a new empty prompt to this section"/>
                    <Button Content="+ Add nested section"
                            Command="{Binding AddNestedSectionCommand}"
                            AutomationProperties.Name="Add nested section"
                            AutomationProperties.HelpText="Append a new empty sub-section inside this section"/>
                    <Button Content="Convert to fixed table"
                            Command="{Binding ConvertToFixedTableCommand}"
                            AutomationProperties.Name="Convert to fixed table"
                            AutomationProperties.HelpText="Promote this section to a fixed-row table — declare columns + predefined rows"/>
                    <Button Content="Convert to dynamic table"
                            Command="{Binding ConvertToDynamicTableCommand}"
                            AutomationProperties.Name="Convert to dynamic table"
                            AutomationProperties.HelpText="Promote this section to a dynamic table — declare columns; users add rows at fill time"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Table section: column editor + (fixed) row list, or row config preview ── -->
            <StackPanel IsVisible="{Binding IsTableSection}" Spacing="10">
                <Border Padding="10"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Table layout"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Fixed table: every row is declared here. Users can fill cells but can't add or remove rows when filling out the form."
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsFixedTable}"/>
                        <TextBlock Text="Dynamic table: rows are added by the user at fill time. Configure the columns + label/bounds below, then press Ctrl+E to switch to preview mode and try adding rows."
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsDynamicTable}"/>

                        <!-- Column list editor -->
                        <TextBlock Text="Columns" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Column = label + type. Id is auto-generated like regular
                                         prompts; authors don't edit it inline. Mirrors PromptEditorView. -->
                                    <Grid ColumnDefinitions="*,8,140,8,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Label, Mode=TwoWay}"
                                                 PlaceholderText="Column header"
                                                 AutomationProperties.Name="Column header"/>
                                        <ComboBox Grid.Column="2"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  PlaceholderText="text"
                                                  AutomationProperties.Name="Column type">
                                            <ComboBoxItem>text</ComboBoxItem>
                                            <ComboBoxItem>number</ComboBoxItem>
                                            <ComboBoxItem>currency</ComboBoxItem>
                                            <ComboBoxItem>date</ComboBoxItem>
                                            <ComboBoxItem>boolean</ComboBoxItem>
                                            <ComboBoxItem>email</ComboBoxItem>
                                            <ComboBoxItem>url</ComboBoxItem>
                                            <ComboBoxItem>phone</ComboBoxItem>
                                        </ComboBox>
                                        <Button Grid.Column="4"
                                                Content="✕"
                                                FontSize="11"
                                                Padding="6,2"
                                                MinHeight="28"
                                                MinWidth="28"
                                                ToolTip.Tip="Remove this column"
                                                AutomationProperties.Name="Remove column"
                                                Click="OnRemoveColumnClick"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add column"
                                HorizontalAlignment="Left"
                                Command="{Binding AddColumnCommand}"
                                AutomationProperties.Name="Add column"/>

                        <!-- Fixed table: row list editor -->
                        <TextBlock Text="Rows"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding IsFixedTable}"/>
                        <ItemsControl IsVisible="{Binding IsFixedTable}"
                                      ItemsSource="{Binding NestedSections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SectionViewModel">
                                    <!-- Fixed row = label only. Id is auto-generated; authors
                                         never edit it inline (matches column + prompt behavior). -->
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Title, Mode=TwoWay}"
                                                 PlaceholderText="Row label"
                                                 AutomationProperties.Name="Row label"/>
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                FontSize="11"
                                                Padding="6,2"
                                                MinHeight="28"
                                                MinWidth="28"
                                                ToolTip.Tip="Remove this row"
                                                AutomationProperties.Name="Remove row"
                                                Click="OnRemoveFixedRowClick"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button IsVisible="{Binding IsFixedTable}"
                                Content="+ Add row"
                                HorizontalAlignment="Left"
                                Command="{Binding AddFixedRowCommand}"
                                AutomationProperties.Name="Add row"/>

                        <!-- Dynamic table: advisory capacity -->
                        <StackPanel IsVisible="{Binding IsDynamicTable}" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Row settings" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="180,8,*" RowDefinitions="Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Maximum rows"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Advisory cap on how many rows a filler may add. Leave blank for no limit. A form carrying more rows than this is still valid."/>
                                <TextBox Grid.Row="0" Grid.Column="2"
                                         Text="{Binding MaxRowsText, Mode=TwoWay}"
                                         PlaceholderText="No limit"
                                         AutomationProperties.Name="Maximum rows"
                                         AutomationProperties.HelpText="Advisory only. Leave blank for no limit."/>
                            </Grid>
                            <TextBlock Text="New rows copy the shape and naming of the rows already present."
                                       FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="Convert to regular section"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Command="{Binding RemoveTableLayoutCommand}"
                                ToolTip.Tip="Convert this table back into a regular section. Its rows remain as ordinary child sections."
                                AutomationProperties.Name="Remove table layout"
                                AutomationProperties.HelpText="Convert this table back into a regular section. Its rows remain as ordinary child sections."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Recursive: nested sections rendered via SectionEditorView -->
            <ItemsControl x:Name="NestedSectionsList"
                          ItemsSource="{Binding NestedSections}"
                          Margin="20,8,0,0"
                          AutomationProperties.Name="Nested sections">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SectionViewModel">
                        <editor:SectionEditorView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
