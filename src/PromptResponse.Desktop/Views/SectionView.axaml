<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             xmlns:vmp="using:PromptResponse.Desktop.ViewModels.Prompts"
             xmlns:views="using:PromptResponse.Desktop.Views"
             xmlns:promptViews="using:PromptResponse.Desktop.Views.Prompts"
             x:Class="PromptResponse.Desktop.Views.SectionView"
             x:DataType="vm:SectionViewModel"
             AutomationProperties.Name="{Binding Title}"
             AutomationProperties.HelpText="{Binding Description}">

    <UserControl.Resources>
        <promptViews:PromptDataTemplateSelector x:Key="PromptTemplate"/>
    </UserControl.Resources>

    <StackPanel Spacing="14">
        <!-- Section heading: font shrinks slightly with depth so nested sections
             read as subordinate to their parent. Top-level: 18pt; deeper levels
             clamp to 14pt so the visual hierarchy stays readable but not tiny. -->
        <StackPanel Spacing="2">
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       AutomationProperties.Name="{Binding Title}">
                <TextBlock.FontSize>
                    <MultiBinding Converter="{x:Static views:SectionView.SectionTitleSizeConverter}">
                        <Binding Path="Depth"/>
                    </MultiBinding>
                </TextBlock.FontSize>
            </TextBlock>
            <SelectableTextBlock Text="{Binding Description}"
                       FontSize="13"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasDescription}"/>
        </StackPanel>

        <!-- ── Regular section layout: prompts + nested sub-sections ── -->
        <!-- A capped measure: a name field stretched across a wide window reads as a
             wireframe. MaxWidth without an alignment change, so children still stretch
             to the cap instead of shrinking to their content. -->
        <StackPanel Spacing="12" MaxWidth="760"
                    IsVisible="{Binding IsRegularSection}">
            <ItemsControl ItemsSource="{Binding PromptViewModels}"
                          AutomationProperties.Name="Prompts">
                <!--
                    Wrapped once here rather than in each of the thirteen prompt views:
                    a role badge above the field, then the field itself via the type
                    selector. A field belonging to someone else is marked and de-emphasised
                    but never disabled — the format has no idea who is at the keyboard, and
                    a nurse covering reception must not be stopped by a dropdown (spec 4.10).
                -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            Yours is marked by an accent rule, not by dimming everyone
                            else's. Reducing opacity on the other party's fields would cut
                            text contrast to make an ownership point, which is the wrong
                            trade in a form somebody has to read.
                        -->
                        <StackPanel Spacing="3"
                                    AutomationProperties.HelpText="{Binding RoleAnnouncement}">
                            <!--
                                Signature coverage, in the same place and the same shape
                                as the role badge rather than a second vocabulary. Text
                                always; the colour cue only where the active profile says
                                colour carries meaning, and never as the sole channel.
                            -->
                            <Border IsVisible="{Binding ShowSignatureMark}"
                                    Background="{DynamicResource SystemChromeMediumLowColor}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="7" Height="7" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding SignatureColorCue}"
                                            Background="{DynamicResource SystemAccentColor}"/>
                                    <TextBlock Text="{Binding SignatureLabel}"
                                               FontSize="11"
                                               Opacity="0.85"
                                               AutomationProperties.Name="{Binding SignatureAnnouncement}"/>
                                </StackPanel>
                            </Border>
                            <Border IsVisible="{Binding RoleBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Background="{DynamicResource SystemChromeMediumLowColor}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RoleBadge}"
                                           FontSize="11"
                                           Opacity="0.85"
                                           AutomationProperties.Name="{Binding RoleAnnouncement}"/>
                            </Border>
                            <Border BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="3,0,0,0"
                                    Padding="9,0,0,0"
                                    HorizontalAlignment="Stretch">
                                <Border.IsVisible>
                                    <Binding Path="ShowsMineAccent"/>
                                </Border.IsVisible>
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource PromptTemplate}"/>
                            </Border>
                            <ContentControl Content="{Binding}"
                                            IsVisible="{Binding !ShowsMineAccent}"
                                            ContentTemplate="{StaticResource PromptTemplate}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <!-- Conditional visibility (exprHidden) and read-only (exprValue/
                         exprReadOnly) are driven per-prompt: bind the item container
                         to the prompt VM's IsVisible / IsInputEnabled. -->
                    <Style Selector="ContentPresenter">
                        <Setter Property="IsVisible" Value="{ReflectionBinding IsVisible}"/>
                        <Setter Property="IsEnabled" Value="{ReflectionBinding IsInputEnabled}"/>
                    </Style>

                </ItemsControl.Styles>
            </ItemsControl>

            <!-- Recursive nested sections, indented with a left rule. The left-rule
                 carries the active profile's accent so it picks up theme changes,
                 and indents are uniform per nesting level so a 3-deep section
                 reads visibly indented from a 2-deep one. -->
            <ItemsControl ItemsSource="{Binding NestedSections}"
                          Margin="0,8,0,0"
                          AutomationProperties.Name="Nested sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SectionViewModel">
                        <Border BorderThickness="2,0,0,0"
                                BorderBrush="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileBorderBrush, FallbackValue={x:Null}}"
                                Padding="20,6,0,6"
                                Margin="0,0,0,0">
                            <views:SectionView/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- ── Table-section layout: column headers + row cells + add button ──
             Used when Section.TableLayout is set. The row sub-sections live in
             NestedSections but here they're rendered inline as table rows
             (header + cells + remove button per row). -->
        <Border IsVisible="{Binding IsTableSection}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="0">
            <StackPanel Spacing="0">
                <!-- Header row: leading blank cell aligns with the row-label
                     gutter on each row, then one header per declared column. -->
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Border MinWidth="160"
                            Padding="10,8"
                            BorderThickness="0,0,1,1"
                            AutomationProperties.Name="Row labels"/>
                    <ItemsControl ItemsSource="{Binding Columns}"
                                  AutomationProperties.Name="Table column headers">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="160"
                                        Padding="10,8"
                                        BorderThickness="0,0,1,1">
                                    <SelectableTextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               AutomationProperties.HelpText="{Binding HelpText}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Rows: NestedSections rendered as one row per child SectionViewModel -->
                <ItemsControl ItemsSource="{Binding NestedSections}"
                              AutomationProperties.Name="Table rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SectionViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <!-- Row label cell + remove button -->
                                <Border MinWidth="160"
                                        Padding="10,8"
                                        BorderThickness="0,0,1,1"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <Button Content="✕"
                                                FontSize="11"
                                                Padding="4,0"
                                                MinHeight="22"
                                                MinWidth="22"
                                                ToolTip.Tip="Remove this row"
                                                AutomationProperties.Name="Remove row"
                                                AutomationProperties.HelpText="{Binding Title}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:SectionViewModel)DataContext).IsDynamicTable}"
                                                Command="{Binding $parent[ItemsControl].((vm:SectionViewModel)DataContext).RemoveRowCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cells in column order. Cells need a visible
                                     resting state so users can see where to
                                     click — without it, empty borderless
                                     TextBoxes are invisible until focused. -->
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vmp:TableCellViewModel">
                                            <Border MinWidth="160"
                                                    BorderThickness="0,0,1,1"
                                                    Background="#08000000">
                                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                         PlaceholderText="{Binding Placeholder}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         CornerRadius="0"
                                                         MinHeight="36"
                                                         FontSize="13"
                                                         AutomationProperties.Name="{Binding ColumnLabel}"
                                                         AutomationProperties.HelpText="Cell — any visible text is a valid response"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add-row button: only for dynamic tables -->
                <Button Content="+ Add row"
                        Margin="8"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsDynamicTable}"
                        Command="{Binding AddRowCommand}"
                        AutomationProperties.Name="Add row"
                        AutomationProperties.HelpText="Append a new empty row to the table"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
