<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PromptResponse.Desktop.ViewModels"
        x:Class="PromptResponse.Desktop.Views.S3ConfigurationWindow"
        x:DataType="vm:S3ConfigurationViewModel"
        Title="Configure S3 Submission"
        Width="550"
        Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        AutomationProperties.Name="S3 Configuration Dialog">

    <Window.Styles>
        <StyleInclude Source="/Styles/ModernControls.axaml"/>
    </Window.Styles>

    <DockPanel Margin="24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="S3 Submission Configuration"
                       FontSize="20"
                       FontWeight="SemiBold"
                       AutomationProperties.Name="Dialog title"/>
            <TextBlock Text="Configure where completed forms will be submitted"
                       FontSize="13"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Status Icon - shows green when configured, gray otherwise -->
                <Ellipse Grid.Column="0"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         IsVisible="{Binding IsConfigured}"
                         Fill="#4CAF50"/>
                <Ellipse Grid.Column="0"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         IsVisible="{Binding !IsConfigured}"
                         Fill="{DynamicResource SystemBaseMediumColor}"/>

                <!-- Status Text -->
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="{Binding ConfigStatusText}"
                               FontWeight="Medium"
                               AutomationProperties.Name="Configuration status"/>
                    <TextBlock Text="{Binding ExpirationStatusText}"
                               FontSize="12"
                               Margin="0,2,0,0"
                               IsVisible="{Binding IsConfigured}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               AutomationProperties.Name="Expiration status"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="2"
                        Command="{Binding RefreshExpirationCommand}"
                        ToolTip.Tip="Refresh expiration date"
                        Padding="8,4"
                        IsVisible="{Binding IsConfigured}"
                        AutomationProperties.Name="Refresh expiration"
                        AutomationProperties.HelpText="Generate a new policy with extended expiration date">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Width="14" Height="14"/>
                        <TextBlock Text="Refresh" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button Content="Remove Configuration"
                    Command="{Binding RemoveConfigCommand}"
                    Classes="modern"
                    Padding="16,8"
                    IsVisible="{Binding IsConfigured}"
                    AutomationProperties.Name="Remove S3 configuration"
                    AutomationProperties.HelpText="Remove the S3 submission configuration from this template"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="modern"
                    Padding="16,8"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel button"/>
            <Button Content="Apply Configuration"
                    Command="{Binding GenerateConfigCommand}"
                    Classes="modern-accent"
                    Padding="16,8"
                    IsDefault="True"
                    AutomationProperties.Name="Apply S3 configuration"
                    AutomationProperties.HelpText="Generate and apply the S3 submission configuration"/>
        </StackPanel>

        <!-- Status Message -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,12,0,0"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       AutomationProperties.Name="Status message"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <!-- Main Form -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- AWS/S3 Settings -->
                <Border Classes="modern-card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="S3 Bucket Settings"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Bucket Name *"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBox Text="{Binding BucketName}"
                                     Watermark="my-forms-bucket"
                                     Classes="modern"
                                     AutomationProperties.Name="S3 bucket name"
                                     AutomationProperties.HelpText="The name of your S3 bucket where forms will be submitted"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Region"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBox Text="{Binding Region}"
                                     Watermark="us-east-1"
                                     Classes="modern"
                                     AutomationProperties.Name="AWS region"
                                     AutomationProperties.HelpText="The AWS region where your bucket is located"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Key Prefix"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBox Text="{Binding KeyPrefix}"
                                     Watermark="submissions/"
                                     Classes="modern"
                                     AutomationProperties.Name="Object key prefix"
                                     AutomationProperties.HelpText="Folder path prefix for uploaded files"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Credentials -->
                <Border Classes="modern-card" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="AWS Credentials"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="(not stored in template)"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="4"
                                Padding="12">
                            <TextBlock Text="Credentials are used to generate a pre-signed policy. Only the policy signature is embedded in the template - your secret key is never stored."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Access Key ID *"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBox Text="{Binding AccessKeyId}"
                                     Watermark="AKIAIOSFODNN7EXAMPLE"
                                     Classes="modern"
                                     AutomationProperties.Name="AWS Access Key ID"
                                     AutomationProperties.HelpText="Your AWS Access Key ID"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Secret Access Key *"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBox Text="{Binding SecretAccessKey}"
                                     PasswordChar="*"
                                     Watermark="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
                                     Classes="modern"
                                     AutomationProperties.Name="AWS Secret Access Key"
                                     AutomationProperties.HelpText="Your AWS Secret Access Key - used only for signing"/>
                        </StackPanel>

                        <Button Command="{Binding TestConnectionCommand}"
                                Content="Test Connection"
                                Classes="modern"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Test S3 connection"
                                AutomationProperties.HelpText="Test connectivity to the S3 bucket"/>
                    </StackPanel>
                </Border>

                <!-- Template Updates (allows form fillers to check for new versions) -->
                <Border Classes="modern-card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Template Updates"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="4"
                                Padding="12">
                            <TextBlock Text="If you provide a URL, form fillers can check for template updates. The URL should point to where this template file will be hosted."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Template Source URL (optional)"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBox Text="{Binding TemplateSourceUrl}"
                                     Watermark="https://my-bucket.s3.us-east-1.amazonaws.com/templates/form.aprt"
                                     Classes="modern"
                                     AutomationProperties.Name="Template source URL"
                                     AutomationProperties.HelpText="URL where this template will be hosted, allowing form fillers to check for updates"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Advanced Options -->
                <Expander Header="Advanced Options" IsExpanded="False">
                    <Border Classes="modern-card" Padding="16" Margin="0,8,0,0">
                        <StackPanel Spacing="12">
                            <!-- Custom Endpoint (MinIO) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Custom Endpoint (MinIO/S3-compatible)"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                <TextBox Text="{Binding CustomEndpoint}"
                                         Watermark="http://localhost:9000"
                                         Classes="modern"
                                         AutomationProperties.Name="Custom S3 endpoint"
                                         AutomationProperties.HelpText="For MinIO or other S3-compatible services"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding UsePathStyle}"
                                      Content="Use path-style URLs"
                                      AutomationProperties.Name="Use path-style URLs"
                                      AutomationProperties.HelpText="Required for MinIO and some S3-compatible services"/>

                            <Separator Height="1" Margin="0,8"/>

                            <!-- Expiration -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Policy Expiration (days)"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                <NumericUpDown Value="{Binding ExpirationDays}"
                                               Minimum="1"
                                               Maximum="365"
                                               Increment="1"
                                               FormatString="N0"
                                               Width="120"
                                               HorizontalAlignment="Left"
                                               AutomationProperties.Name="Policy expiration days"
                                               AutomationProperties.HelpText="Number of days until the submission policy expires"/>
                            </StackPanel>

                            <!-- Max File Size -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Maximum File Size (MB)"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                <NumericUpDown Value="{Binding MaxFileSizeMB}"
                                               Minimum="1"
                                               Maximum="100"
                                               Increment="1"
                                               FormatString="N0"
                                               Width="120"
                                               HorizontalAlignment="Left"
                                               AutomationProperties.Name="Maximum file size"
                                               AutomationProperties.HelpText="Maximum size of submitted form files in megabytes"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
