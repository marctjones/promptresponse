<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             x:Class="PromptResponse.Desktop.Views.TemplateEditorView"
             x:DataType="vm:TemplateEditorViewModel">

    <Design.DataContext>
        <vm:TemplateEditorViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveCommand}"
                        Content="💾 Save Template"
                        Padding="12,6"
                        ToolTip.Tip="Save template (Ctrl+S)"
                        AutomationProperties.Name="Save template button"/>
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveAsCommand}"
                        Content="Save As..."
                        Padding="12,6"
                        ToolTip.Tip="Save as new template (Ctrl+Shift+S)"
                        AutomationProperties.Name="Save As button"/>
                <Separator Width="1" Height="24" Margin="8,0"/>
                <Button Command="{Binding AddSectionCommand}"
                        Content="➕ Add Section"
                        Padding="12,6"
                        ToolTip.Tip="Add a new section to the template"
                        AutomationProperties.Name="Add section button"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Mode}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SaveStateText}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemAccentColor}"/>
            </Grid>
        </Border>

        <!-- Main content grid with sidebar -->
        <Grid ColumnDefinitions="*,Auto,250">
            <!-- Main content area -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          Name="MainScrollViewer">
                <Grid Margin="24">
                    <StackPanel HorizontalAlignment="Stretch">
                <!-- Template Metadata -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20"
                        Margin="0,0,0,24"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Template Information"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Title *"
                                       FontWeight="Medium"/>
                            <TextBox Text="{Binding Title}"
                                     Watermark="Enter template title"
                                     MinHeight="36"
                                     Padding="10,8"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="Template title"
                                     AutomationProperties.HelpText="The main title of the template"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Description"
                                       FontWeight="Medium"/>
                            <TextBox Text="{Binding Description}"
                                     Watermark="Optional description"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="60"
                                     Padding="10,8"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="Template description"
                                     AutomationProperties.HelpText="Optional description of what this template is for"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sections -->
                <ItemsControl ItemsSource="{Binding Sections}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Margin="0,0,0,16"
                                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    HorizontalAlignment="Stretch">
                                <Expander IsExpanded="{Binding IsExpanded}"
                                          HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="4,8">
                                                <TextBox Text="{Binding Title}"
                                                         Watermark="Section title"
                                                         FontSize="18"
                                                         FontWeight="SemiBold"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         AutomationProperties.Name="Section title"/>
                                                <TextBox Text="{Binding Description}"
                                                         Watermark="Optional description"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource SystemBaseMediumColor}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         Margin="0,4,0,0"
                                                         AutomationProperties.Name="Section description"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding RemoveSectionCommand}"
                                                    Content="🗑️"
                                                    Padding="8"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0"
                                                    ToolTip.Tip="Remove this section"
                                                    AutomationProperties.Name="Remove section"/>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Margin="20,12,20,16" Spacing="12">
                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding AddPromptCommand}"
                                                    Content="➕ Add Prompt"
                                                    Padding="10,6"
                                                    FontSize="12"
                                                    AutomationProperties.Name="Add prompt to section"/>
                                            <Button Command="{Binding AddSubsectionCommand}"
                                                    Content="➕ Add Subsection"
                                                    Padding="10,6"
                                                    FontSize="12"
                                                    AutomationProperties.Name="Add subsection"/>
                                        </StackPanel>

                                        <!-- Subsections -->
                                        <ItemsControl ItemsSource="{Binding Subsections}"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,8"
                                                            Padding="12"
                                                            HorizontalAlignment="Stretch">
                                                        <Expander IsExpanded="{Binding IsExpanded}"
                                                                  HorizontalAlignment="Stretch">
                                                            <Expander.Header>
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding Title}"
                                                                             Watermark="Subsection title"
                                                                             FontSize="15"
                                                                             FontWeight="Medium"
                                                                             BorderThickness="0"
                                                                             Background="Transparent"
                                                                             Padding="4"
                                                                             AutomationProperties.Name="Subsection title"/>
                                                                    <Button Grid.Column="1"
                                                                            Command="{Binding RemoveSubsectionCommand}"
                                                                            Content="🗑️"
                                                                            Padding="6"
                                                                            FontSize="12"
                                                                            ToolTip.Tip="Remove subsection"
                                                                            AutomationProperties.Name="Remove subsection"/>
                                                                </Grid>
                                                            </Expander.Header>

                                                            <StackPanel Margin="8" Spacing="8">
                                                                <!-- Subsection Description -->
                                                                <TextBox Text="{Binding Description}"
                                                                         Watermark="Optional description"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         MinHeight="40"
                                                                         FontSize="13"
                                                                         Padding="8"
                                                                         Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                         AutomationProperties.Name="Subsection description"
                                                                         AutomationProperties.HelpText="Optional description for this subsection"/>

                                                                <Button Command="{Binding AddPromptCommand}"
                                                                        Content="➕ Add Prompt"
                                                                        Padding="8,4"
                                                                        FontSize="11"
                                                                        AutomationProperties.Name="Add prompt to subsection"/>

                                                                <!-- Prompts in Subsection -->
                                                                <ItemsControl ItemsSource="{Binding Prompts}"
                                                                              HorizontalAlignment="Stretch">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4"
                                                                                    Padding="12"
                                                                                    Margin="0,4"
                                                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                                    HorizontalAlignment="Stretch">
                                                                                <StackPanel Spacing="8">
                                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                                        <TextBlock Text="Prompt" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
                                                                                    </Grid>

                                                                                    <TextBox Text="{Binding Label}"
                                                                                             Watermark="Prompt label (required)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             FontWeight="Medium"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Prompt label"/>
                                                                                    <TextBox Text="{Binding Placeholder}"
                                                                                             Watermark="Placeholder text (optional)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Prompt placeholder"/>
                                                                                    <TextBox Text="{Binding HelpText}"
                                                                                             Watermark="Help text (optional)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             AcceptsReturn="True"
                                                                                             TextWrapping="Wrap"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Prompt help text"/>
                                                                                    <TextBox Text="{Binding ExpectedDataType}"
                                                                                             Watermark="Expected data type (e.g., email, phone, date)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Expected data type"
                                                                                             AutomationProperties.HelpText="Advisory hint for field type - does not enforce validation"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Expander>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Section-level Prompts -->
                                        <ItemsControl ItemsSource="{Binding Prompts}"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="12"
                                                            Margin="0,4"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                            HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="Prompt" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
                                                            </Grid>

                                                            <TextBox Text="{Binding Label}"
                                                                     Watermark="Prompt label (required)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     FontWeight="Medium"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Prompt label"/>
                                                            <TextBox Text="{Binding Placeholder}"
                                                                     Watermark="Placeholder text (optional)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Prompt placeholder"/>
                                                            <TextBox Text="{Binding HelpText}"
                                                                     Watermark="Help text (optional)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Prompt help text"/>
                                                            <TextBox Text="{Binding ExpectedDataType}"
                                                                     Watermark="Expected data type (e.g., email, phone, date)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Expected data type"
                                                                     AutomationProperties.HelpText="Advisory hint for field type - does not enforce validation"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Sidebar separator -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Section navigation sidebar -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sections"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource SystemBaseMediumHighColor}"/>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6"
                                            Margin="0,2"
                                            Background="Transparent"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SystemBaseMediumHighColor}"
                                                   ToolTip.Tip="{Binding Title}"
                                                   AutomationProperties.Name="{Binding Title}"/>
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
