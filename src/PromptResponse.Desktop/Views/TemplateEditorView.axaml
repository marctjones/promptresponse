<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             x:Class="PromptResponse.Desktop.Views.TemplateEditorView"
             x:DataType="vm:TemplateEditorViewModel">

    <Design.DataContext>
        <vm:TemplateEditorViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="command-bar">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveCommand}"
                        Classes="modern-accent"
                        ToolTip.Tip="Save template (Ctrl+S)"
                        AutomationProperties.Name="Save template button">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Save Template" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveAsCommand}"
                        Classes="modern"
                        ToolTip.Tip="Save as new template (Ctrl+Shift+S)"
                        AutomationProperties.Name="Save As button">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Save As..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Width="1" Height="24" Margin="4,0"/>
                <Button Command="{Binding AddSectionCommand}"
                        Classes="modern"
                        ToolTip.Tip="Add a new section to the template"
                        AutomationProperties.Name="Add section button">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Add Section" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Classes="status-bar">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Mode}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="{StaticResource FontWeightMedium}"
                           Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SaveStateText}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource SystemAccentColor}"/>
            </Grid>
        </Border>

        <!-- Main content grid with sidebar -->
        <Grid ColumnDefinitions="*,Auto,250">
            <!-- Main content area -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          Name="MainScrollViewer">
                <Grid Margin="24">
                    <StackPanel HorizontalAlignment="Stretch">
                <!-- Template Metadata -->
                <Border Classes="modern-card"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Template Information"
                                   Classes="section-title"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Title *"
                                       Classes="field-label"/>
                            <TextBox Text="{Binding Title}"
                                     Classes="modern"
                                     Watermark="Enter template title"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="Template title"
                                     AutomationProperties.HelpText="The main title of the template"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Description"
                                       Classes="field-label"/>
                            <TextBox Text="{Binding Description}"
                                     Classes="modern"
                                     Watermark="Optional description"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="Template description"
                                     AutomationProperties.HelpText="Optional description of what this template is for"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sections -->
                <ItemsControl ItemsSource="{Binding Sections}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="section-card"
                                    BorderThickness="2"
                                    HorizontalAlignment="Stretch"
                                    Tag="{Binding}">
                                <Expander Classes="modern"
                                          IsExpanded="{Binding IsExpanded}"
                                          HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="4,8">
                                                <TextBox Text="{Binding Title}"
                                                         Watermark="Section title"
                                                         FontSize="18"
                                                         FontWeight="SemiBold"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         AutomationProperties.Name="Section title"/>
                                                <TextBox Text="{Binding Description}"
                                                         Watermark="Optional description"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource SystemBaseMediumColor}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         Margin="0,4,0,0"
                                                         AutomationProperties.Name="Section description"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding RemoveSectionCommand}"
                                                    Content="🗑️"
                                                    Padding="8"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0"
                                                    ToolTip.Tip="Remove this section"
                                                    AutomationProperties.Name="Remove section"/>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Margin="20,12,20,16" Spacing="12">
                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding AddPromptCommand}"
                                                    Classes="modern"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    AutomationProperties.Name="Add prompt to section">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                              Width="12" Height="12"/>
                                                    <TextBlock Text="Add Prompt" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding AddSubsectionCommand}"
                                                    Classes="modern"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    AutomationProperties.Name="Add subsection">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                              Width="12" Height="12"/>
                                                    <TextBlock Text="Add Subsection" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Subsections -->
                                        <ItemsControl ItemsSource="{Binding Subsections}"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,8"
                                                            Padding="12"
                                                            HorizontalAlignment="Stretch">
                                                        <Expander IsExpanded="{Binding IsExpanded}"
                                                                  HorizontalAlignment="Stretch">
                                                            <Expander.Header>
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding Title}"
                                                                             Watermark="Subsection title"
                                                                             FontSize="15"
                                                                             FontWeight="Medium"
                                                                             BorderThickness="0"
                                                                             Background="Transparent"
                                                                             Padding="4"
                                                                             AutomationProperties.Name="Subsection title"/>
                                                                    <Button Grid.Column="1"
                                                                            Command="{Binding RemoveSubsectionCommand}"
                                                                            Content="🗑️"
                                                                            Padding="6"
                                                                            FontSize="12"
                                                                            ToolTip.Tip="Remove subsection"
                                                                            AutomationProperties.Name="Remove subsection"/>
                                                                </Grid>
                                                            </Expander.Header>

                                                            <StackPanel Margin="8" Spacing="8">
                                                                <!-- Subsection Description -->
                                                                <TextBox Text="{Binding Description}"
                                                                         Watermark="Optional description"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         MinHeight="40"
                                                                         FontSize="13"
                                                                         Padding="8"
                                                                         Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                         AutomationProperties.Name="Subsection description"
                                                                         AutomationProperties.HelpText="Optional description for this subsection"/>

                                                                <Button Command="{Binding AddPromptCommand}"
                                                                        Content="➕ Add Prompt"
                                                                        Padding="8,4"
                                                                        FontSize="11"
                                                                        AutomationProperties.Name="Add prompt to subsection"/>

                                                                <!-- Prompts in Subsection -->
                                                                <ItemsControl ItemsSource="{Binding Prompts}"
                                                                              HorizontalAlignment="Stretch">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4"
                                                                                    Padding="12"
                                                                                    Margin="0,4"
                                                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                                    HorizontalAlignment="Stretch">
                                                                                <StackPanel Spacing="8">
                                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                                        <TextBlock Text="Prompt" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
                                                                                    </Grid>

                                                                                    <TextBox Text="{Binding Label}"
                                                                                             Watermark="Prompt label (required)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             FontWeight="Medium"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Prompt label"/>
                                                                                    <TextBox Text="{Binding Placeholder}"
                                                                                             Watermark="Placeholder text (optional)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Prompt placeholder"/>
                                                                                    <TextBox Text="{Binding HelpText}"
                                                                                             Watermark="Help text (optional)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             AcceptsReturn="True"
                                                                                             TextWrapping="Wrap"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Prompt help text"/>
                                                                                    <AutoCompleteBox Text="{Binding ExpectedDataType}"
                                                                                                     ItemsSource="{x:Static vm:TemplateEditorViewModel.ValidFieldTypes}"
                                                                                                     Watermark="Select or type field type (e.g., email, phone, date)"
                                                                                                     MinHeight="32"
                                                                                                     HorizontalAlignment="Stretch"
                                                                                                     AutomationProperties.Name="Expected data type"
                                                                                                     AutomationProperties.HelpText="Select a standard field type or enter a custom value - advisory hint only, does not enforce validation"/>
                                                                                    <TextBox Text="{Binding SuggestedValuesText}"
                                                                                             Watermark="Suggested values (comma-separated, e.g., Option 1, Option 2, Option 3)"
                                                                                             MinHeight="32"
                                                                                             Padding="8"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             AutomationProperties.Name="Suggested values"
                                                                                             AutomationProperties.HelpText="Comma-separated list of suggested values that will appear in autocomplete dropdown"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Expander>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Section-level Prompts -->
                                        <ItemsControl ItemsSource="{Binding Prompts}"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="12"
                                                            Margin="0,4"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                            HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="Prompt" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
                                                            </Grid>

                                                            <TextBox Text="{Binding Label}"
                                                                     Watermark="Prompt label (required)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     FontWeight="Medium"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Prompt label"/>
                                                            <TextBox Text="{Binding Placeholder}"
                                                                     Watermark="Placeholder text (optional)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Prompt placeholder"/>
                                                            <TextBox Text="{Binding HelpText}"
                                                                     Watermark="Help text (optional)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Prompt help text"/>
                                                            <AutoCompleteBox Text="{Binding ExpectedDataType}"
                                                                             ItemsSource="{x:Static vm:TemplateEditorViewModel.ValidFieldTypes}"
                                                                             Watermark="Select or type field type (e.g., email, phone, date)"
                                                                             MinHeight="32"
                                                                             HorizontalAlignment="Stretch"
                                                                             AutomationProperties.Name="Expected data type"
                                                                             AutomationProperties.HelpText="Select a standard field type or enter a custom value - advisory hint only, does not enforce validation"/>
                                                            <TextBox Text="{Binding SuggestedValuesText}"
                                                                     Watermark="Suggested values (comma-separated, e.g., Option 1, Option 2, Option 3)"
                                                                     MinHeight="32"
                                                                     Padding="8"
                                                                     HorizontalAlignment="Stretch"
                                                                     AutomationProperties.Name="Suggested values"
                                                                     AutomationProperties.HelpText="Comma-separated list of suggested values that will appear in autocomplete dropdown"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Sidebar separator -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Section navigation sidebar -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sections"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource SystemBaseMediumHighColor}"/>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}"
                                            Tag="{Binding}"
                                            Click="OnSectionNavigationClick"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6"
                                            Margin="0,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Foreground="{DynamicResource SystemBaseMediumHighColor}"
                                            ToolTip.Tip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Navigate to section: {0}'}"
                                            AutomationProperties.HelpText="Click to scroll to this section in the template">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
                                            </Style>
                                            <Style Selector="Button:focus">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
