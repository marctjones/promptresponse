<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels"
             xmlns:promptVm="using:PromptResponse.Desktop.ViewModels.Prompts"
             xmlns:promptViews="using:PromptResponse.Desktop.Views.Prompts"
             xmlns:views="using:PromptResponse.Desktop.Views"
             xmlns:editor="using:PromptResponse.Desktop.Views.Editor"
             x:Class="PromptResponse.Desktop.Views.MainShellView"
             x:Name="Root"
             x:DataType="vm:MainShellViewModel"
             AutomationProperties.Name="PromptResponse main shell"
             AutomationProperties.HelpText="Form designer and filler workspace">

    <UserControl.Resources>
        <promptViews:PromptDataTemplateSelector x:Key="PromptTemplate"/>
    </UserControl.Resources>

    <!--
        Background bound to the active profile's Surface color. TextElement.Foreground
        cascades OnSurface to every TextBlock. This is what fixes the "everything is
        black" regression — without it, the Window falls through to the OS variant and
        our text colors fight the OS-painted background.
    -->
    <DockPanel Background="{Binding ActiveProfileSurfaceBrush}"
               TextElement.Foreground="{Binding ActiveProfileOnSurfaceBrush}">

        <!-- ============= Native menu bar ============= -->
        <Menu DockPanel.Dock="Top"
              Background="{Binding ActiveProfileSubtleSurfaceBrush}"
              FontSize="{Binding BodyFontSize}"
              AutomationProperties.Name="Main menu"
              AutomationProperties.HelpText="File, View, and Help menus">
            <MenuItem Header="_File" AutomationProperties.Name="File menu">
                <MenuItem Header="_New Template..."
                          Command="{Binding NewTemplateCommand}"
                          HotKey="Ctrl+N"
                          InputGesture="Ctrl+N"
                          AutomationProperties.Name="New template"
                          AutomationProperties.HelpText="Create a new blank APR template (Ctrl+N)"/>
                <MenuItem Header="_Open..."
                          Command="{Binding OpenCommand}"
                          HotKey="Ctrl+O"
                          InputGesture="Ctrl+O"
                          AutomationProperties.Name="Open file"
                          AutomationProperties.HelpText="Open an existing APR template or filled form (Ctrl+O)"/>
                <Separator/>
                <MenuItem Header="_Save"
                          Command="{Binding SaveCommand}"
                          HotKey="Ctrl+S"
                          InputGesture="Ctrl+S"
                          AutomationProperties.Name="Save"/>
                <MenuItem Header="Save _As..."
                          Command="{Binding SaveAsCommand}"
                          HotKey="Ctrl+Shift+S"
                          InputGesture="Ctrl+Shift+S"
                          AutomationProperties.Name="Save as"/>
                <Separator/>
                <MenuItem Header="_Export"
                          AutomationProperties.Name="Export menu">
                    <MenuItem Header="Export as _PDF..."
                              Command="{Binding ExportPdfCommand}"
                              AutomationProperties.Name="Export as PDF"
                              AutomationProperties.HelpText="Export the current form, with its values, to a flat PDF"/>
                    <MenuItem Header="Export as fillable PDF _form..."
                              Command="{Binding ExportPdfFormCommand}"
                              AutomationProperties.Name="Export as fillable PDF form"
                              AutomationProperties.HelpText="Export to an interactive PDF with fillable fields"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Close"
                          Command="{Binding CloseCommand}"
                          HotKey="Ctrl+W"
                          InputGesture="Ctrl+W"
                          AutomationProperties.Name="Close"/>
            </MenuItem>
            <MenuItem Header="_Edit" AutomationProperties.Name="Edit menu">
                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          HotKey="Ctrl+Z"
                          InputGesture="Ctrl+Z"
                          AutomationProperties.Name="Undo"
                          AutomationProperties.HelpText="Reverse the most recent edit (Ctrl+Z)"/>
                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          HotKey="Ctrl+Y"
                          InputGesture="Ctrl+Y"
                          AutomationProperties.Name="Redo"
                          AutomationProperties.HelpText="Re-apply the most recently undone edit (Ctrl+Y)"/>
            </MenuItem>
            <MenuItem Header="_View" AutomationProperties.Name="View menu">
                <MenuItem Header="Capability _Profile"
                          AutomationProperties.Name="Capability profile menu"
                          AutomationProperties.HelpText="Switch the active capability-profile preset">
                    <MenuItem Header="_Excellent vision (default)"
                              Command="{Binding ApplyPresetCommand}"
                              CommandParameter="ExcellentVision"
                              AutomationProperties.Name="Excellent vision preset"/>
                    <MenuItem Header="_Blind / screen reader"
                              Command="{Binding ApplyPresetCommand}"
                              CommandParameter="BlindScreenReader"
                              AutomationProperties.Name="Blind screen reader preset"/>
                    <MenuItem Header="_Low vision / high contrast"
                              Command="{Binding ApplyPresetCommand}"
                              CommandParameter="LowVisionHighContrast"
                              AutomationProperties.Name="Low vision high contrast preset"/>
                    <MenuItem Header="_Cognitive / dyslexia"
                              Command="{Binding ApplyPresetCommand}"
                              CommandParameter="CognitiveDyslexia"
                              AutomationProperties.Name="Cognitive preset"/>
                    <MenuItem Header="_Motor / mobility"
                              Command="{Binding ApplyPresetCommand}"
                              CommandParameter="MotorMobility"
                              AutomationProperties.Name="Motor mobility preset"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Toggle _Edit Mode"
                          Command="{Binding ToggleEditModeCommand}"
                          IsEnabled="{Binding CanToggleEditMode}"
                          HotKey="Ctrl+E"
                          InputGesture="Ctrl+E"
                          AutomationProperties.Name="Toggle edit mode"
                          AutomationProperties.HelpText="Switch between structural editor (template authoring) and fillable preview (Ctrl+E). Only available for templates."/>
                <MenuItem Header="Toggle _Wizard Mode"
                          Command="{Binding ToggleWizardModeCommand}"
                          HotKey="Ctrl+W"
                          InputGesture="Ctrl+W"
                          AutomationProperties.Name="Toggle wizard mode"
                          AutomationProperties.HelpText="Switch between section-at-a-time (wizard) and full-list rendering (Ctrl+W)"/>
                <Separator/>
                <MenuItem Header="_Display Preferences..."
                          x:Name="DisplayPreferencesMenuItem"
                          Click="OnDisplayPreferencesClicked"
                          AutomationProperties.Name="Display preferences"
                          AutomationProperties.HelpText="Configure color scheme, text scale, and other rendering enhancements"/>
                <Separator/>
                <MenuItem Header="Keyboard _Shortcuts..."
                          x:Name="KeyboardShortcutsMenuItem"
                          Click="OnKeyboardShortcutsClicked"
                          HotKey="F1"
                          InputGesture="F1"
                          AutomationProperties.Name="Keyboard shortcuts"/>
            </MenuItem>
            <MenuItem Header="_Help" AutomationProperties.Name="Help menu">
                <MenuItem Header="_About"
                          x:Name="AboutMenuItem"
                          Click="OnAboutClicked"
                          AutomationProperties.Name="About PromptResponse"/>
            </MenuItem>
        </Menu>

        <!-- ============= Status bar (screen-reader live region) ============= -->
        <Border DockPanel.Dock="Bottom"
                Background="{Binding ActiveProfileSubtleSurfaceBrush}"
                Padding="14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{Binding ActiveProfileBorderBrush}"
                AutomationProperties.Name="Status"
                AutomationProperties.LiveSetting="Polite">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="{Binding CaptionFontSize}"
                           Foreground="{Binding ActiveProfileMutedTextBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Progress.StatusText}"
                           VerticalAlignment="Center"
                           FontSize="{Binding CaptionFontSize}"
                           Foreground="{Binding ActiveProfileMutedTextBrush}"
                           Margin="16,0,0,0"
                           AutomationProperties.Name="Form completion"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>

        <!-- ============= Empty state ============= -->
        <Panel IsVisible="{Binding IsEmptyState}"
               AutomationProperties.Name="Empty state"
               AutomationProperties.HelpText="No document is open">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24"
                        MaxWidth="520">
                <TextBlock Text="PromptResponse"
                           FontSize="{Binding DisplayFontSize}"
                           FontWeight="Light"
                           HorizontalAlignment="Center"
                           Foreground="{Binding ActiveProfileOnSurfaceBrush}"/>
                <TextBlock Text="A semantic form designer and filler. Open or create a form to begin."
                           FontSize="{Binding SubtitleFontSize}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{Binding ActiveProfileMutedTextBrush}"/>
                <Border IsVisible="{Binding ShowGettingStarted}"
                        Background="{Binding ActiveProfileElevatedSurfaceBrush}"
                        BorderBrush="{Binding ActiveProfileBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,4,0,0"
                        AutomationProperties.Name="Getting started">
                    <TextBlock Text="New here? Pick a starter template below to see how a form is built, or create a blank template. Press F1 anytime for keyboard shortcuts."
                               FontSize="{Binding CaptionFontSize}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{Binding ActiveProfileOnSurfaceBrush}"/>
                </Border>
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button Command="{Binding NewTemplateCommand}"
                            Background="{Binding ActiveProfilePrimaryBrush}"
                            Foreground="{Binding ActiveProfileOnPrimaryBrush}"
                            MinHeight="44" MinWidth="180"
                            Padding="20,10"
                            FontSize="{Binding BodyFontSize}"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            AutomationProperties.Name="Create new template"
                            AutomationProperties.HelpText="Start designing a new APR template (Ctrl+N)">
                        <TextBlock Text="New template" />
                    </Button>
                    <Button Command="{Binding OpenCommand}"
                            Background="{Binding ActiveProfileElevatedSurfaceBrush}"
                            Foreground="{Binding ActiveProfileOnSurfaceBrush}"
                            BorderBrush="{Binding ActiveProfileBorderBrush}"
                            BorderThickness="1"
                            MinHeight="44" MinWidth="180"
                            Padding="20,10"
                            FontSize="{Binding BodyFontSize}"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            AutomationProperties.Name="Open existing file"
                            AutomationProperties.HelpText="Open an existing APR template or filled form (Ctrl+O)">
                        <TextBlock Text="Open file" />
                    </Button>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasRecentFiles}"
                            Spacing="4"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Recent files">
                    <TextBlock Text="Recent"
                               FontWeight="SemiBold"
                               Opacity="0.8"
                               Foreground="{Binding ActiveProfileOnSurfaceBrush}"/>
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentFileViewModel">
                                <Button Command="{Binding #Root.((vm:MainShellViewModel)DataContext).OpenRecentCommand}"
                                        CommandParameter="{Binding Path}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Padding="8,6"
                                        MinHeight="40"
                                        CornerRadius="6"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        AutomationProperties.HelpText="{Binding Path}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Opacity="0.6"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasStarterTemplates}"
                            Spacing="4"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Start from a template">
                    <TextBlock Text="Start from a template"
                               FontWeight="SemiBold"
                               Opacity="0.8"
                               Foreground="{Binding ActiveProfileOnSurfaceBrush}"/>
                    <ItemsControl ItemsSource="{Binding StarterTemplates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentFileViewModel">
                                <Button Command="{Binding #Root.((vm:MainShellViewModel)DataContext).NewFromTemplateCommand}"
                                        CommandParameter="{Binding Path}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Padding="8,6"
                                        MinHeight="40"
                                        CornerRadius="6"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        AutomationProperties.HelpText="Create a new form from this template">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="Tip: press F1 anytime to see keyboard shortcuts. View → Display Preferences lets you configure visual formatting, large text, high contrast, and more."
                           FontSize="{Binding CaptionFontSize}"
                           Foreground="{Binding ActiveProfileMutedTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,16,0,0"
                           MaxWidth="440"/>
            </StackPanel>
        </Panel>

        <!-- ============= Main 3-column layout ============= -->
        <Grid IsVisible="{Binding HasDocument}"
              ColumnDefinitions="260,*,320">

            <!-- Left rail: section navigation + search -->
            <Border Grid.Column="0"
                    Background="{Binding ActiveProfileSubtleSurfaceBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{Binding ActiveProfileBorderBrush}"
                    AutomationProperties.Name="Sections sidebar">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="6">
                        <TextBlock Text="Search"
                                   FontWeight="SemiBold"
                                   FontSize="{Binding CaptionFontSize}"
                                   Foreground="{Binding ActiveProfileMutedTextBrush}"/>
                        <TextBox x:Name="SearchTextBox"
                                 Text="{Binding Search.Query, Mode=TwoWay}"
                                 Watermark="Find a prompt..."
                                 MinHeight="36"
                                 CornerRadius="6"
                                 FontSize="{Binding BodyFontSize}"
                                 AutomationProperties.Name="Search prompts"
                                 AutomationProperties.HelpText="Type to find prompts by label or response"/>
                        <TextBlock Text="{Binding Search.MatchCount, StringFormat='{}{0} matches'}"
                                   FontSize="{Binding CaptionFontSize}"
                                   Foreground="{Binding ActiveProfileMutedTextBrush}"
                                   IsVisible="{Binding Search.Query, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Document"
                               FontWeight="SemiBold"
                               FontSize="{Binding CaptionFontSize}"
                               Foreground="{Binding ActiveProfileMutedTextBrush}"
                               Margin="16,16,16,4"/>
                    <ScrollViewer>
                        <StackPanel Margin="16,4,16,16" Spacing="2">
                            <TextBlock Text="{Binding CurrentDocumentTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding BodyFontSize}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding ActiveProfileOnSurfaceBrush}"/>
                            <TextBlock Text="{Binding Mode}"
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Center: section + prompt content -->
            <ScrollViewer Grid.Column="1"
                          AutomationProperties.Name="Form content">
                <StackPanel Margin="32,28,32,28" Spacing="0">
                    <!-- Document header -->
                    <TextBlock Text="{Binding CurrentDocumentTitle}"
                               FontSize="{Binding TitleFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{Binding ActiveProfileOnSurfaceBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DocumentDescription}"
                               FontSize="{Binding BodyFontSize}"
                               Foreground="{Binding ActiveProfileMutedTextBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasDocumentDescription}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FilledByDisplay}"
                               FontSize="{Binding CaptionFontSize}"
                               Foreground="{Binding ActiveProfileMutedTextBrush}"
                               IsVisible="{Binding FilledByDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Margin="0,0,0,24"/>

                    <!-- Mode banner: shown when a template is being authored to make
                         the current rendering mode explicit, with a quick toggle. -->
                    <Border IsVisible="{Binding IsEditingTemplate}"
                            Background="{Binding ActiveProfileSubtleSurfaceBrush}"
                            BorderThickness="1"
                            BorderBrush="{Binding ActiveProfileBorderBrush}"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Template — Edit mode"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"
                                       IsVisible="{Binding IsEditMode}"/>
                            <TextBlock Text="Template — Preview (fillable) mode"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"
                                       IsVisible="{Binding IsEditMode, Converter={x:Static BoolConverters.Not}}"/>
                            <Button Content="Toggle (Ctrl+E)"
                                    Command="{Binding ToggleEditModeCommand}"
                                    AutomationProperties.Name="Toggle edit mode"/>
                        </StackPanel>
                    </Border>

                    <!-- Edit-mode: document metadata editor (collapsed by default) -->
                    <Expander IsVisible="{Binding IsEditMode}"
                              Header="Document metadata"
                              Margin="0,0,0,16"
                              AutomationProperties.Name="Document metadata"
                              AutomationProperties.HelpText="Edit document title, description, author, template id, and version">
                        <Grid IsEnabled="{Binding HasDocument}"
                              ColumnDefinitions="160,12,*"
                              RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                              Margin="0,8,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="2"
                                     Text="{Binding Metadata.Title, Mode=TwoWay, FallbackValue=''}"
                                     Watermark="Document title"
                                     AutomationProperties.Name="Document title"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description" VerticalAlignment="Top"/>
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     Text="{Binding Metadata.Description, Mode=TwoWay, FallbackValue=''}"
                                     Watermark="Optional description"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="48"
                                     AutomationProperties.Name="Document description"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Author" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="2"
                                     Text="{Binding Metadata.Author, Mode=TwoWay, FallbackValue=''}"
                                     Watermark="Template author"
                                     AutomationProperties.Name="Author"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Template ID" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="2"
                                     Text="{Binding Metadata.TemplateId, Mode=TwoWay, FallbackValue=''}"
                                     Watermark="Stable template identifier (e.g. employment-app-v1)"
                                     AutomationProperties.Name="Template id"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Template version" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="2"
                                     Text="{Binding Metadata.TemplateVersion, Mode=TwoWay, FallbackValue=''}"
                                     Watermark="e.g. 1.0"
                                     AutomationProperties.Name="Template version"/>
                        </Grid>
                    </Expander>

                    <!-- Wizard nav bar — visible when wizard mode is on. Section
                         step label + Previous/Next on the right. -->
                    <Border IsVisible="{Binding IsWizardMode}"
                            Background="{Binding ActiveProfileSubtleSurfaceBrush}"
                            BorderThickness="1"
                            BorderBrush="{Binding ActiveProfileBorderBrush}"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding WizardStepLabel}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding BodyFontSize}"
                                       Foreground="{Binding ActiveProfileOnSurfaceBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="◀ Previous"
                                        Command="{Binding WizardPreviousCommand}"
                                        AutomationProperties.Name="Previous section"/>
                                <Button Content="Next ▶"
                                        Command="{Binding WizardNextCommand}"
                                        AutomationProperties.Name="Next section"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Wizard mode: render only the current section ── -->
                    <ContentControl IsVisible="{Binding IsWizardMode}"
                                    Content="{Binding WizardCurrentSection}">
                        <ContentControl.DataTemplates>
                            <!-- Edit-mode wizard cell -->
                            <DataTemplate DataType="vm:SectionViewModel">
                                <Border Padding="20"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        Background="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileElevatedSurfaceBrush}"
                                        BorderBrush="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileBorderBrush}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Panel>
                                        <editor:SectionEditorView IsVisible="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).IsEditMode}"/>
                                        <views:SectionView IsVisible="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).IsEditMode, Converter={x:Static BoolConverters.Not}}"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>

                    <!-- Wizard nav (bottom): Previous / Next mirrors the top bar
                         so users at the bottom of a long section don't have to
                         scroll back up to advance. -->
                    <Grid IsVisible="{Binding IsWizardMode}"
                          ColumnDefinitions="*,Auto"
                          Margin="0,16,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding WizardStepLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="{Binding CaptionFontSize}"
                                   Foreground="{Binding ActiveProfileMutedTextBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="◀ Previous"
                                    Command="{Binding WizardPreviousCommand}"
                                    AutomationProperties.Name="Previous section (bottom)"/>
                            <Button Content="Next ▶"
                                    Command="{Binding WizardNextCommand}"
                                    AutomationProperties.Name="Next section (bottom)"/>
                        </StackPanel>
                    </Grid>

                    <!-- Edit-mode section tree (template authoring) -->
                    <ItemsControl x:Name="SectionsHostEdit"
                                  IsVisible="{Binding ShowFullEditList}"
                                  ItemsSource="{Binding Sections}"
                                  AutomationProperties.Name="Form sections (edit mode)">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SectionViewModel">
                                <Border Padding="20"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        Background="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileElevatedSurfaceBrush}"
                                        BorderBrush="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileBorderBrush}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <editor:SectionEditorView/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Edit-mode: top-level section management -->
                    <Button IsVisible="{Binding ShowFullEditList}"
                            Content="+ Add top-level section"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Command="{Binding AddTopLevelSectionCommand}"
                            AutomationProperties.Name="Add top-level section"
                            AutomationProperties.HelpText="Append a new top-level section to the document"/>

                    <!-- Fill-mode section tree (the existing, fillable form) -->
                    <ItemsControl x:Name="SectionsHost"
                                  IsVisible="{Binding ShowFullFillList}"
                                  ItemsSource="{Binding Sections}"
                                  AutomationProperties.Name="Form sections">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SectionViewModel">
                                <Border Padding="24"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        Background="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileElevatedSurfaceBrush}"
                                        BorderBrush="{Binding $parent[Window].((vm:MainShellViewModel)DataContext).ActiveProfileBorderBrush}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <views:SectionView/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="20"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Right rail: progress + advisories -->
            <Border Grid.Column="2"
                    Background="{Binding ActiveProfileSubtleSurfaceBrush}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{Binding ActiveProfileBorderBrush}"
                    AutomationProperties.Name="Form progress and advisories">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="24">

                        <!-- Progress -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Progress"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"/>
                            <ProgressBar Value="{Binding Progress.PercentComplete}"
                                         Maximum="100"
                                         Height="8"
                                         CornerRadius="4"
                                         Foreground="{Binding ActiveProfilePrimaryBrush}"
                                         AutomationProperties.Name="Form completion progress"
                                         AutomationProperties.HelpText="{Binding Progress.StatusText}"/>
                            <TextBlock Text="{Binding Progress.StatusText}"
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ItemsControl ItemsSource="{Binding Progress.Sections}"
                                          IsVisible="{Binding HasDocument}"
                                          AutomationProperties.Name="Section completion">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SectionProgress">
                                        <Grid ColumnDefinitions="*,Auto"
                                              Margin="0,2"
                                              AutomationProperties.Name="{Binding Title}"
                                              AutomationProperties.HelpText="{Binding StatusText}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="{Binding $parent[ItemsControl].((vm:MainShellViewModel)DataContext).CaptionFontSize}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding $parent[ItemsControl].((vm:MainShellViewModel)DataContext).ActiveProfileOnSurfaceBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusText}"
                                                       Margin="8,0,0,0"
                                                       FontSize="{Binding $parent[ItemsControl].((vm:MainShellViewModel)DataContext).CaptionFontSize}"
                                                       Foreground="{Binding $parent[ItemsControl].((vm:MainShellViewModel)DataContext).ActiveProfileMutedTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Advisories — never blocking, never error-styled -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Advisories"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"/>
                            <Button Content="Refresh"
                                    Click="OnRefreshAdvisoriesClicked"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="32"
                                    CornerRadius="6"
                                    AutomationProperties.Name="Refresh advisories"
                                    AutomationProperties.HelpText="Re-run the type-hint inspection across the form"/>
                            <TextBlock Text="{Binding AdvisorySummary}"
                                       FontSize="{Binding BodyFontSize}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ItemsControl ItemsSource="{Binding Advisories}"
                                          x:Name="AdvisoryList"
                                          AutomationProperties.Name="Advisory list">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AdvisoryItem">
                                        <Button Command="{Binding #Root.((vm:MainShellViewModel)DataContext).FocusAdvisoryCommand}"
                                                CommandParameter="{Binding PromptId}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                Padding="8,6" Margin="0,2"
                                                CornerRadius="4"
                                                BorderThickness="1"
                                                BorderBrush="{Binding #Root.((vm:MainShellViewModel)DataContext).ActiveProfileBorderBrush}"
                                                AutomationProperties.Name="{Binding PromptLabel}"
                                                AutomationProperties.HelpText="{Binding Message}"
                                                ToolTip.Tip="Go to this field">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding PromptLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Message}"
                                                           FontSize="11"
                                                           Opacity="0.8"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Advisories are non-blocking. Any visible text is a valid response — hints help you fill in the form, they don't restrict you."
                                       FontSize="{Binding CaptionFontSize}"
                                       Foreground="{Binding ActiveProfileMutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
