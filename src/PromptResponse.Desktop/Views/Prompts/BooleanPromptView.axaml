<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.BooleanPromptView"
             x:DataType="vm:BooleanPromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{Binding Label}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="YesRadio"
                         Content="Yes"
                         GroupName="{Binding Id}"
                         MinHeight="36"
                         IsVisible="{Binding ShowRadiosNow}"
                         AutomationProperties.Name="Yes"
                         AutomationProperties.HelpText="{Binding HelpText}"/>
            <RadioButton x:Name="NoRadio"
                         Content="No"
                         GroupName="{Binding Id}"
                         MinHeight="36"
                         IsVisible="{Binding ShowRadiosNow}"
                         AutomationProperties.Name="No"
                         AutomationProperties.HelpText="{Binding HelpText}"/>
            <TextBox x:Name="FreeTextEntry"
                     Text="{Binding Response, Mode=TwoWay}"
                     PlaceholderText="Type any answer"
                     Width="240"
                     MinHeight="36"
                     IsVisible="{Binding ShowRawEditor}"
                     AutomationProperties.Name="Free-text response"
                     AutomationProperties.HelpText="Any text is a valid response, including 'maybe' or 'depends'"/>
            <Button Content="{Binding RawToggleGlyph}"
                    FontSize="{Binding ToggleGlyphSize}"
                    Command="{Binding ToggleRawEditingCommand}"
                    IsVisible="{Binding ShowRawToggle}"
                    Height="{Binding ToggleButtonSize}"
                    Width="{Binding ToggleButtonSize}"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding RawToggleName}"
                    AutomationProperties.Name="{Binding RawToggleName}"
                    AutomationProperties.HelpText="Any text is a valid response. Switch to a plain text box to type something the suggested input cannot express."/>

        </StackPanel>
        <SelectableTextBlock Text="{Binding HelpText}"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12"
                   Foreground="{DynamicResource SystemBaseMediumColor}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
