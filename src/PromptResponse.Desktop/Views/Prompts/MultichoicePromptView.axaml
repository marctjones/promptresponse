<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.MultichoicePromptView"
             x:DataType="vm:MultichoicePromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
        <ItemsControl x:Name="ChoicesHost"
                      IsVisible="{Binding ShowHintedWidget}"
                      ItemsSource="{Binding SuggestedValues}"
                      AutomationProperties.Name="{Binding Label}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                    <CheckBox Content="{Binding}"
                              Click="OnChoiceClicked"
                              MinHeight="36"
                              Margin="0,2"
                              AutomationProperties.Name="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="FreeTextEntry"
                 IsVisible="{Binding IsRawEditing}"
                 Text="{Binding Response, Mode=TwoWay}"
                 PlaceholderText="Or type a comma-separated response"
                 MinHeight="36"
                 CornerRadius="6"
                 AutomationProperties.Name="Free-text response"
                 AutomationProperties.HelpText="Any text is a valid response — the comma-separated checkbox state is just a convenient default."/>
        <Button Content="{Binding RawToggleGlyph}"
                    FontSize="{Binding ToggleGlyphSize}"
                Command="{Binding ToggleRawEditingCommand}"
                HorizontalAlignment="Left"
                Height="{Binding ToggleButtonSize}"
                Width="{Binding ToggleButtonSize}"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="{Binding RawToggleName}"
                AutomationProperties.Name="{Binding RawToggleName}"
                AutomationProperties.HelpText="Any text is a valid response. Switch to a plain text box to type something the suggested input cannot express."/>
        <TextBlock Text="{Binding HelpText}"
                   FontSize="12" Opacity="0.7"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </StackPanel>
</UserControl>
