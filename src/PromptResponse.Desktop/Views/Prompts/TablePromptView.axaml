<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.TablePromptView"
             x:DataType="vm:TablePromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{Binding Label}"/>

        <TextBlock Text="{Binding HelpText}"
                   FontSize="12" Opacity="0.7"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap"/>

        <!-- ── Per-cell editor (only when a TableDefinition is configured) ── -->
        <Border IsVisible="{Binding HasDefinition}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">

            <StackPanel Spacing="0">

                <!-- Header row: blank label cell + one header per declared column -->
                <ItemsControl x:Name="HeaderRow"
                              ItemsSource="{Binding Columns}"
                              AutomationProperties.Name="Table column headers">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="160"
                                    Padding="10,8"
                                    BorderThickness="0,0,1,1">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           AutomationProperties.HelpText="{Binding HelpText}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- One row per TableRowViewModel -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              AutomationProperties.Name="Table rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TableRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <!-- Row label cell (matches column header zone in alignment) -->
                                <Border MinWidth="160"
                                        Padding="10,8"
                                        BorderThickness="0,0,1,1"
                                        AutomationProperties.Name="{Binding Label}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <!-- Remove-row button: only when dynamic + can-remove -->
                                        <Button Content="✕"
                                                FontSize="11"
                                                Padding="4,0"
                                                MinHeight="22"
                                                MinWidth="22"
                                                ToolTip.Tip="Remove this row"
                                                AutomationProperties.Name="Remove row"
                                                AutomationProperties.HelpText="{Binding Label}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:TablePromptViewModel)DataContext).IsDynamicTable}"
                                                Command="{Binding $parent[ItemsControl].((vm:TablePromptViewModel)DataContext).RemoveRowCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cells in column order -->
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TableCellViewModel">
                                            <Border MinWidth="160"
                                                    BorderThickness="0,0,1,1">
                                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                         Watermark="{Binding Placeholder}"
                                                         BorderThickness="0"
                                                         CornerRadius="0"
                                                         MinHeight="36"
                                                         FontSize="13"
                                                         AutomationProperties.Name="{Binding ColumnLabel}"
                                                         AutomationProperties.HelpText="Cell — any visible text is a valid response"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add-row button: only for dynamic tables -->
                <Button x:Name="AddRowButton"
                        Content="+ Add row"
                        Margin="8"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsDynamicTable}"
                        Command="{Binding AddRowCommand}"
                        AutomationProperties.Name="Add row"
                        AutomationProperties.HelpText="Append a new empty row to the table"/>

            </StackPanel>
        </Border>

        <!-- ── Free-text fallback (no TableDefinition configured) ── -->
        <TextBox IsVisible="{Binding HasDefinition, Converter={x:Static BoolConverters.Not}}"
                 Text="{Binding Response, Mode=TwoWay}"
                 Watermark="Tabular response — paste or type the JSON array/object below."
                 MinHeight="120"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Cascadia Mono,Consolas,monospace"
                 FontSize="13"
                 CornerRadius="6"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="Tabular response stored as JSON. Free-text is also valid."/>
    </StackPanel>
</UserControl>
