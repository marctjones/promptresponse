<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.CurrencyPromptView"
             x:DataType="vm:CurrencyPromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
        <TextBox x:Name="ResponseTextBox"
                 Text="{Binding Response, Mode=TwoWay}"
                 Watermark="{Binding Placeholder, FallbackValue='Amount'}"
                 MinHeight="36"
                 CornerRadius="6"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="{Binding HelpText}"/>
        <TextBlock Text="{Binding DisplayValue, StringFormat='Displays as: {0}'}"
                   FontSize="12" Opacity="0.7"
                   IsVisible="{Binding ShowDisplaysAs}"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding HelpText}"
                   FontSize="12" Opacity="0.7"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </StackPanel>
</UserControl>
