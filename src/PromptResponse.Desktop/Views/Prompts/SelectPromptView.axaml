<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.SelectPromptView"
             x:DataType="vm:SelectPromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{Binding Label}"/>
        <!--
            ComboBox + free-text TextBox: the user can pick from suggestions OR
            type any value. Per the vision, the suggestions are a hint, not a constraint.
        -->
        <Grid ColumnDefinitions="Auto,*">
            <ComboBox Grid.Column="0"
                      x:Name="SuggestionsCombo"
                      ItemsSource="{Binding SuggestedValues}"
                      SelectedItem="{Binding Response, Mode=TwoWay}"
                      MinHeight="36"
                      MinWidth="200"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="Choose a suggested answer"/>
            <TextBox Grid.Column="1"
                     x:Name="FreeTextEntry"
                     Text="{Binding Response, Mode=TwoWay}"
                     PlaceholderText="Or type any answer"
                     Margin="8,0,0,0"
                     MinHeight="36"
                     AutomationProperties.Name="Free-text response"
                     AutomationProperties.HelpText="Type any answer; not limited to the suggestion list"/>
        </Grid>
        <TextBlock Text="{Binding HelpText}"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>
</UserControl>
