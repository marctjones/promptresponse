<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.MultilinePromptView"
             x:DataType="vm:MultilinePromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{Binding Label}"/>
        <TextBox x:Name="ResponseTextBox"
                 Text="{Binding Response, Mode=TwoWay}"
                 Watermark="{Binding Placeholder}"
                 MinHeight="96"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="{Binding HelpText}"/>
        <TextBlock Text="{Binding HelpText}"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>
</UserControl>
