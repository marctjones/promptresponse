<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.PhonePromptView"
             x:DataType="vm:PhonePromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
        <TextBox x:Name="ResponseTextBox"
                 Text="{Binding Response, Mode=TwoWay}"
                 PlaceholderText="{Binding Placeholder, FallbackValue='(555) 555-5555'}"
                 MinHeight="36"
                 CornerRadius="3"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="{Binding HelpText}"/>
        <SelectableTextBlock Text="{Binding HelpText}"
                   FontSize="12" Opacity="0.7"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
