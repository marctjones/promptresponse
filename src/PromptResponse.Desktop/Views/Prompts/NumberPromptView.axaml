<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.NumberPromptView"
             x:DataType="vm:NumberPromptViewModel">
    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{Binding Label}"/>
        <TextBox x:Name="ResponseTextBox"
                 Text="{Binding Response, Mode=TwoWay}"
                 Watermark="{Binding Placeholder}"
                 MinHeight="36"
                 CornerRadius="6"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="{Binding HelpText}"/>
        <!--
            Live formatted preview. Visible only when DisplayValue differs from
            the raw Response — i.e., when the active profile (e.g. VisualFormatting)
            renders a different visible string. The raw response is what's stored.
        -->
        <TextBlock x:Name="DisplayHint"
                   Text="{Binding DisplayValue, StringFormat='Displays as: {0}'}"
                   IsVisible="{Binding ShowDisplaysAs}"
                   FontSize="12"
                   Opacity="0.7"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding HelpText}"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12"
                   Opacity="0.7"/>
    </StackPanel>
</UserControl>
