<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PromptResponse.Desktop.ViewModels.Prompts"
             x:Class="PromptResponse.Desktop.Views.Prompts.TextPromptView"
             x:DataType="vm:TextPromptViewModel"
             AutomationProperties.AutomationId="{Binding Id}">
    <StackPanel Spacing="6">
        <TextBlock x:Name="LabelText"
                   Text="{Binding Label}"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="{Binding Label}"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="ResponseTextBox"
                     Text="{Binding Response, Mode=TwoWay}"
                     PlaceholderText="{Binding Placeholder}"
                     MinHeight="36"
                     AutomationProperties.Name="{Binding Label}"
                     AutomationProperties.HelpText="{Binding HelpText}"/>
            <!-- A colour field previews what its text means. Decoration only: it has no
                 accessible name, takes no focus, and the text box remains the answer. -->
            <Border x:Name="ColorSwatch"
                    Grid.Column="1"
                    Width="36" Height="36"
                    Margin="8,0,0,0"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Pr.DividerBrush}"
                    IsVisible="False"
                    Focusable="False"
                    IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <SelectableTextBlock x:Name="HelpText"
                   Text="{Binding HelpText}"
                   IsVisible="{Binding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   FontSize="12"
                   Foreground="{DynamicResource Pr.MutedTextBrush}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
