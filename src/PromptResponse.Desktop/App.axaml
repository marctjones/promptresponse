<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PromptResponse.Desktop.App"
             Name="PromptResponse"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <!--
            Palette brushes for views that are not bound to the shell (the per-field
            views and dialogs). App.axaml.cs replaces each with the active profile's
            brush whenever the profile changes, so Dark and High Contrast reach help
            text and quiet controls instead of stopping at the shell. These defaults are
            the FluentTheme colours the views used before, so a view hosted without a
            profile renders exactly as it did.
        -->
        <SolidColorBrush x:Key="Pr.MutedTextBrush" Color="{DynamicResource SystemBaseMediumColor}"/>
        <SolidColorBrush x:Key="Pr.DividerBrush" Color="{DynamicResource SystemBaseLowColor}"/>
        <SolidColorBrush x:Key="Pr.SurfaceBrush" Color="{DynamicResource SystemAltHighColor}"/>
        <SolidColorBrush x:Key="Pr.PrimaryBrush" Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="Pr.OnPrimaryBrush" Color="White"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--
            App-wide control shape and density on top of FluentTheme. Anything
            profile-aware renders through ColorTokens.cs + the per-profile shell, not
            styles — keep this section profile-agnostic.

            The house style is a desktop application somebody works in all day, not a
            consumer app they visit. Three things follow from that and are why these
            values are what they are:

              Small radii. Controls sit at 4, grouped surfaces at 4, structural panels
              at 0. 4 is the Windows 11 value for in-page controls (its 8 is for
              windows, flyouts and dialogs, which this app does not draw itself) and
              0 is its value where straight edges meet. Large radii read as consumer
              software, and a global rounding on Border rounds panel edges and
              dividers too, which is what made every region look like a card.

              No web conventions. A hand cursor means "hyperlink"; on a desktop button
              it is simply wrong, and it was applied to every button in the app.

              No motion for its own sake. A button that scales when pressed is a
              flourish; in a form somebody fills forty times a day it is friction.
              State changes are immediate. Colour transitions stay, because they help
              a change of state register without drawing attention to themselves.
        -->

        <!--
            Field width follows the expected input, not the window (Apple HIG: field
            widths proportional to what goes in them; Windows 11: 50-60 characters a
            line). A number or phone is short, so it is not drawn across the whole
            column. Width, not MaxWidth, so the TextBox inside still fills the field.
        -->
        <Style Selector=":is(Control).field-short">
            <Setter Property="Width" Value="320"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector=":is(Control).field-medium">
            <Setter Property="Width" Value="480"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!--
            The raw-text toggle sits beside nearly every field and is rarely the thing a
            person came to do, so it is a quiet icon button: no fill, no outline, muted
            glyph, a subtle fill only on hover or press. It keeps its size (36, the touch
            target), command, tooltip and accessible name; the raw-text path is never
            removed, only made to recede.
        -->
        <Style Selector="Button.raw-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Pr.MutedTextBrush}"/>
        </Style>
        <Style Selector="Button.raw-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.raw-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListLowColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.raw-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!--
            The primary action is drawn once per navigation bar, from the palette's Primary and
            OnPrimary roles (so Dark and High Contrast reach it), not from the system
            accent. Hover dims slightly and the disabled state falls back to a quiet
            outline, so "Next" on the last section reads as unavailable, not as a
            broken filled button.
        -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="{DynamicResource Pr.OnPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pr.PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Pr.PrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Pr.OnPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Pr.DividerBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Pr.MutedTextBrush}"/>
        </Style>

        <!-- Buttons: flat, dense, no bounce, native cursor. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <!-- MinHeight is the accessible touch target and must not shrink with the
                 padding above (IRenderingProfile.MinimumTouchTarget). -->
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <!-- Text inputs: dense, square-ish, with the focus ring intact. -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- A visible focus indicator is not decoration; keep it emphatic. -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!--
            Deliberately NOT a global Border radius. Border is used for panel edges,
            dividers, table rules and grouped cards alike, so rounding all of them
            rounded the application's structure. A Border that wants a radius asks for
            one; the rest stay square.
        -->
    </Application.Styles>
</Application>
