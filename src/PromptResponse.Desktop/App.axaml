<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PromptResponse.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />

        <!-- Custom PromptResponse Styling Enhancement -->
        <!-- These styles add visual polish while respecting the selected theme -->

        <!-- Button Styling - Modern rounded with smooth interactions -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- TextBox Styling - Rounded corners and enhanced focus -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Border Styling - Rounded corners everywhere -->
        <Style Selector="Border">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Application.Styles>
</Application>
