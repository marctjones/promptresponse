<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>apr</AssemblyName>
    <RootNamespace>PromptResponse.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PromptResponse.Cli</PackageId>
    <Version>0.6.0</Version>
    <Authors>PromptResponse Contributors</Authors>
    <Description>Command-line tool for working with APR (Adaptive Prompt Response) files</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yourusername/promptresponse</RepositoryUrl>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>apr</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PromptResponse.Core\PromptResponse.Core.csproj" />
    <ProjectReference Include="..\PromptResponse.Rendering.Pdf\PromptResponse.Rendering.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
  </ItemGroup>

</Project>
