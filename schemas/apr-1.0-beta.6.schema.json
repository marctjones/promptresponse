{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marctjones/promptresponse/main/schemas/apr-1.0-beta.6.schema.json",
  "title": "APR 1.0 beta.6 form or attestation record",
  "description": "Normative structural schema for APR beta.6. A form is independent data; attestations are independent stream records. JSONC/YAML source trivia is removed before schema validation.",
  "oneOf": [
    {
      "title": "APR form",
      "allOf": [
        { "$ref": "apr-1.0.schema.json" },
        {
          "properties": {
            "version": { "const": "1.0-beta.6" },
            "signatures": false
          },
          "$comment": "Embedded beta.3 signatures are retired, not preserved as extension data."
        }
      ]
    },
    {
      "title": "APR attestation",
      "type": "object",
      "required": [ "recordType", "version", "subject", "scope", "manifest", "proofs", "witnesses" ],
      "properties": {
        "recordType": { "const": "attestation" },
        "version": { "const": "1.0-beta.6" },
        "subject": {
          "type": "object",
          "required": [ "digest", "canonicalization" ],
          "properties": {
            "digest": { "$ref": "apr-1.0-beta.6.schema.json#/$defs/sha256" },
            "canonicalization": { "const": "jcs-sha256" }
          },
          "additionalProperties": false
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "required": [ "kind" ],
              "properties": { "kind": { "const": "document" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [ "kind", "fields" ],
              "properties": {
                "kind": { "const": "fields" },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "\\S" }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "manifest": {
          "type": "object",
          "required": [ "root", "entries" ],
          "properties": {
            "root": { "$ref": "apr-1.0-beta.6.schema.json#/$defs/sha256" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [ "path", "digest" ],
                "properties": {
                  "path": { "type": "string", "pattern": "^(?:/|/(?:[^~/]|~[01])*)*$" },
                  "digest": { "$ref": "apr-1.0-beta.6.schema.json#/$defs/sha256" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [ "type", "value" ],
            "properties": {
              "type": { "type": "string", "pattern": "\\S" },
              "value": { "type": "string", "contentEncoding": "base64" }
            },
            "additionalProperties": false
          }
        },
        "witnesses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "apr-1.0-beta.6.schema.json#/$defs/sha256" }
        }
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
