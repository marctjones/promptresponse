<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local feed for the pdfe PDF engine (https://github.com/marctjones/pdfe).
      We consume Pdfe.Core as a locally-packed NuGet package so the two repos
      stay decoupled (no cross-repo ProjectReference). To refresh after a pdfe
      change: see local-nuget/README.md.
    -->
    <add key="pdfe-local" value="local-nuget" />
  </packageSources>
</configuration>
