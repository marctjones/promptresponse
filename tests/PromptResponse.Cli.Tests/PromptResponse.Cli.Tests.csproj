<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Coverage threshold, Include and Exclude live in .github/workflows/ci.yml's "Cli
    coverage gate" step, not here. They used to be duplicated in both places with
    different values (28% on the command line CI actually used, 80% here, neither
    reconciled since 2026-05-01) — the command line wins under MSBuild precedence, so
    the 80% floor here silently stopped being enforced anywhere the moment CI started
    passing an override, and drifted to failing-if-honored (actual: 76.89%) without
    anyone noticing (#345). One source of truth now.
  -->


  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PromptResponse.Core\PromptResponse.Core.csproj" />
    <ProjectReference Include="..\..\src\PromptResponse.Cli\PromptResponse.Cli.csproj" />
  </ItemGroup>

</Project>
