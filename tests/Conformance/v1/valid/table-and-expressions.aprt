{
  "version": "1.0-beta",
  "documentType": "template",
  "metadata": {
    "title": "Conformance Table and Expressions",
    "description": "Fixed table layout plus expression hints.",
    "author": "PromptResponse Conformance",
    "templateId": "conformance-table-expressions",
    "templateVersion": "1.0"
  },
  "sections": [
    {
      "id": "order",
      "title": "Order",
      "prompts": [
        {
          "id": "quantity",
          "label": "Quantity",
          "response": "",
          "hints": {
            "expectedDataType": "number",
            "placeholder": "1"
          }
        },
        {
          "id": "unit_price",
          "label": "Unit price",
          "response": "",
          "hints": {
            "expectedDataType": "currency",
            "placeholder": "0.00"
          }
        },
        {
          "id": "line_total",
          "label": "Line total",
          "response": "",
          "hints": {
            "expectedDataType": "currency",
            "exprValue": "quantity == '' || unit_price == '' ? '' : double(quantity) * double(unit_price)",
            "exprReadOnly": "true"
          }
        },
        {
          "id": "rush",
          "label": "Rush delivery?",
          "response": "",
          "hints": {
            "expectedDataType": "boolean"
          }
        },
        {
          "id": "rush_reason",
          "label": "Reason for rush",
          "response": "",
          "hints": {
            "expectedDataType": "text",
            "exprHidden": "rush != 'true'",
            "exprExpected": "rush == 'true'",
            "exprValidation": "_this == '' && rush == 'true' ? 'Reason is expected for rush delivery' : ''"
          }
        }
      ]
    },
    {
      "id": "quarterly_totals",
      "title": "Quarterly totals",
      "description": "Fixed-row table fixture.",
      "sections": [
        {
          "id": "q1",
          "title": "Q1",
          "prompts": [
            {
              "id": "q1.revenue",
              "label": "Revenue",
              "response": "",
              "hints": {
                "expectedDataType": "currency",
                "placeholder": "0.00"
              }
            },
            {
              "id": "q1.status",
              "label": "Status",
              "response": "",
              "hints": {
                "expectedDataType": "text",
                "suggestedValues": [
                  "Draft",
                  "Final"
                ]
              }
            }
          ]
        },
        {
          "id": "q2",
          "title": "Q2",
          "prompts": [
            {
              "id": "q2.revenue",
              "label": "Revenue",
              "response": "",
              "hints": {
                "expectedDataType": "currency",
                "placeholder": "0.00"
              }
            },
            {
              "id": "q2.status",
              "label": "Status",
              "response": "",
              "hints": {
                "expectedDataType": "text",
                "suggestedValues": [
                  "Draft",
                  "Final"
                ]
              }
            }
          ]
        }
      ],
      "kind": "table"
    }
  ]
}
