{
  "version": "1.0-beta",
  "documentType": "filledForm",
  "metadata": {
    "title": "Conformance Hidden Characters In Responses",
    "description": "A filler's answer keeps every character they typed, including hidden ones, and regardless of the author's type hint. The hint says what was hoped for; it never licenses editing what was written.",
    "templateId": "conformance-hidden-chars",
    "templateVersion": "1.0"
  },
  "sections": [
    {
      "id": "hidden",
      "title": "Responses containing hidden characters",
      "prompts": [
        {
          "id": "url_hint",
          "label": "Your website",
          "response": "https://exam​ple.com",
          "hints": {
            "expectedDataType": "url",
            "helpText": "A url hint MUST NOT cause the response to be rewritten."
          }
        },
        {
          "id": "email_hint",
          "label": "Email address",
          "response": "ada​@example.com",
          "hints": {
            "expectedDataType": "email"
          }
        },
        {
          "id": "text_hint",
          "label": "Free text",
          "response": "exam​ple",
          "hints": {
            "expectedDataType": "text"
          }
        },
        {
          "id": "persian_zwnj",
          "label": "Persian with ZWNJ",
          "response": "می‌روم",
          "hints": {
            "expectedDataType": "text"
          }
        }
      ]
    }
  ]
}
