{
  "version": "1.0-beta",
  "documentType": "template",
  "metadata": {
    "title": "Conformance All Hint Types",
    "description": "Every expectedDataType in the registry. A reader that lacks a widget for one MUST fall back to a plain text field rather than error.",
    "templateId": "conformance-all-hint-types",
    "templateVersion": "1.0"
  },
  "sections": [
    {
      "id": "types",
      "title": "One prompt per registered type hint",
      "prompts": [
        { "id": "t_text",        "label": "Text",            "response": "", "hints": { "expectedDataType": "text" } },
        { "id": "t_multiline",   "label": "Multiline",       "response": "", "hints": { "expectedDataType": "multiline" } },
        { "id": "t_email",       "label": "Email",           "response": "", "hints": { "expectedDataType": "email" } },
        { "id": "t_phone",       "label": "Phone",           "response": "", "hints": { "expectedDataType": "phone" } },
        { "id": "t_url",         "label": "URL",             "response": "", "hints": { "expectedDataType": "url" } },
        { "id": "t_date",        "label": "Date",            "response": "", "hints": { "expectedDataType": "date" } },
        { "id": "t_time",        "label": "Time",            "response": "", "hints": { "expectedDataType": "time" } },
        { "id": "t_datetime",    "label": "Date and time",   "response": "", "hints": { "expectedDataType": "datetime" } },
        { "id": "t_number",      "label": "Number",          "response": "", "hints": { "expectedDataType": "number" } },
        { "id": "t_currency",    "label": "Currency",        "response": "", "hints": { "expectedDataType": "currency" } },
        { "id": "t_boolean",     "label": "Boolean",         "response": "", "hints": { "expectedDataType": "boolean" } },
        { "id": "t_select",      "label": "Select",          "response": "", "hints": { "expectedDataType": "select", "suggestedValues": ["Alpha", "Bravo", "Charlie"] } },
        { "id": "t_multichoice", "label": "Multiple choice", "response": "", "hints": { "expectedDataType": "multichoice", "suggestedValues": ["Red", "Green", "Blue"] } },
        { "id": "t_signature",   "label": "Signature",       "response": "", "hints": { "expectedDataType": "signature" } },
        { "id": "t_file",        "label": "File reference",  "response": "", "hints": { "expectedDataType": "file" } },
        { "id": "t_none",        "label": "No hint at all",  "response": "" }
      ]
    }
  ]
}
