{
  "version": "1.0-beta",
  "documentType": "template",
  "metadata": {
    "title": "Conformance Dynamic Table",
    "description": "A dynamic-table section is the one section permitted to start with no rows.",
    "templateId": "conformance-dynamic-table",
    "templateVersion": "1.0"
  },
  "sections": [
    {
      "id": "claimant",
      "title": "Claimant",
      "prompts": [
        {
          "id": "claimant_name",
          "label": "Claimant name",
          "response": "",
          "hints": {
            "expectedDataType": "text"
          }
        }
      ]
    },
    {
      "id": "line_items",
      "title": "Line items",
      "description": "Empty dynamic table: rows are added at fill time.",
      "kind": "table",
      "canAddRows": "true",
      "maxRows": "25",
      "sections": [
        {
          "id": "row1",
          "title": "Row 1",
          "prompts": [
            {
              "id": "row1.description",
              "label": "Description",
              "response": "",
              "hints": {
                "expectedDataType": "text"
              }
            },
            {
              "id": "row1.amount",
              "label": "Amount",
              "response": "",
              "hints": {
                "expectedDataType": "currency",
                "placeholder": "0.00"
              }
            }
          ]
        }
      ]
    }
  ]
}
