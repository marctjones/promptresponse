{
  "version": "1.0-beta",
  "documentType": "filledForm",
  "metadata": {
    "title": "Conformance Response Edge Cases",
    "description": "String content that has historically broken form tooling. All of it MUST survive a round-trip byte-for-byte.",
    "templateId": "conformance-response-edge-cases",
    "templateVersion": "1.0"
  },
  "sections": [
    {
      "id": "edges",
      "title": "Edge-case response strings",
      "prompts": [
        { "id": "empty",         "label": "Empty string",              "response": "" },
        { "id": "spaces_only",   "label": "Whitespace only",           "response": "   " },
        { "id": "word_null",     "label": "The word null",             "response": "null" },
        { "id": "word_true",     "label": "The word true",             "response": "true" },
        { "id": "numeric_text",  "label": "Digits as text",            "response": "42" },
        { "id": "leading_zero",  "label": "Leading zeros preserved",   "response": "007" },
        { "id": "big_number",    "label": "Beyond double precision",   "response": "9007199254740993" },
        { "id": "quotes",        "label": "Embedded double quotes",    "response": "He said \"hello\"" },
        { "id": "backslash",     "label": "Windows path",              "response": "C:\\Users\\Name\\forms" },
        { "id": "newlines",      "label": "Multi-line answer",         "response": "Line 1\nLine 2\nLine 3", "hints": { "expectedDataType": "multiline" } },
        { "id": "tabs",          "label": "Tab separated",             "response": "a\tb\tc" },
        { "id": "crlf",          "label": "CRLF line ending",          "response": "before\r\nafter" },
        { "id": "currency_sym",  "label": "Currency with symbol",      "response": "$1,234.56", "hints": { "expectedDataType": "currency" } },
        { "id": "json_lookalike","label": "Response that looks like JSON", "response": "{\"not\":\"parsed\"}" },
        { "id": "emoji_zwj",     "label": "Emoji ZWJ sequence",        "response": "👨‍👩‍👧" },
        { "id": "persian_zwnj",  "label": "Persian ZWNJ",              "response": "می‌روم" },
        { "id": "rtl",           "label": "Right-to-left script",      "response": "مرحبا بالعالم" },
        { "id": "cjk",           "label": "CJK",                       "response": "日本語のテキスト" },
        { "id": "combining",     "label": "Combining accent",          "response": "Café" },
        { "id": "long",          "label": "Long response",             "response": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." }
      ]
    }
  ]
}
