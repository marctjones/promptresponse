{
  "version": "1.0-beta",
  "documentType": "template",
  "metadata": {
    "title": "Patient Intake",
    "description": "Three parties fill this form. The roles array names them; sections carry a role and one prompt overrides its section's to hand a single field back to the patient. Roles are advisory: a reader marks fields and never refuses input (spec 4.10).",
    "templateId": "intake",
    "templateVersion": "1.0"
  },
  "roles": [
    {
      "id": "patient",
      "name": "Patient",
      "description": "The person receiving care."
    },
    {
      "id": "nurse",
      "name": "Nurse",
      "description": "Clinical staff recording observations."
    },
    {
      "id": "office",
      "name": "Office use"
    }
  ],
  "sections": [
    {
      "id": "patient_details",
      "title": "About you",
      "role": "patient",
      "prompts": [
        {
          "id": "name",
          "label": "Full name",
          "hints": {
            "expectedDataType": "text"
          }
        },
        {
          "id": "dob",
          "label": "Date of birth",
          "hints": {
            "expectedDataType": "date"
          }
        }
      ]
    },
    {
      "id": "observations",
      "title": "Clinical observations",
      "role": "nurse",
      "prompts": [
        {
          "id": "bp",
          "label": "Blood pressure",
          "hints": {
            "expectedDataType": "text"
          }
        },
        {
          "id": "weight",
          "label": "Weight (kg)",
          "hints": {
            "expectedDataType": "number",
            "min": "0",
            "max": "400"
          }
        },
        {
          "id": "symptoms",
          "label": "Describe your symptoms in your own words",
          "role": "patient",
          "hints": {
            "expectedDataType": "multiline",
            "helpText": "A prompt-level role overrides its section's, so this stays the patient's question inside a nurse's section."
          }
        }
      ]
    },
    {
      "id": "office",
      "title": "For office use only",
      "role": "office",
      "prompts": [
        {
          "id": "ref",
          "label": "Reference number",
          "hints": {
            "expectedDataType": "text"
          }
        },
        {
          "id": "received",
          "label": "Date received",
          "hints": {
            "expectedDataType": "date"
          }
        }
      ]
    },
    {
      "id": "consent",
      "title": "Consent",
      "prompts": [
        {
          "id": "agree",
          "label": "I confirm the above is accurate",
          "hints": {
            "expectedDataType": "boolean",
            "suggestedValues": [
              "Yes",
              "No"
            ]
          }
        }
      ]
    }
  ]
}
