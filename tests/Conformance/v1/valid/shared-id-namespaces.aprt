{
  "version": "1.0-beta",
  "documentType": "template",
  "metadata": {
    "title": "Shared Id Namespaces",
    "description": "A section and a prompt both use the id \"address\". Sections and prompts occupy separate id namespaces (spec 4.4), so this document is valid. Without this fixture an implementation that pooled both into one namespace would pass the entire corpus."
  },
  "sections": [
    {
      "id": "address",
      "title": "Mailing Address",
      "prompts": [
        { "id": "address", "label": "Street address" },
        { "id": "city", "label": "City" }
      ]
    }
  ]
}
