      "id": "filing-status",
      "title": "Filing Status",
      "prompts": [
        {
          "id": "filing_status_choice",
          "label": "Select your filing status",
          "response": "",
          "hints": {
            "expectedDataType": "text",
            "suggestedValues": [
              "Single",
              "Married filing jointly",
              "Married filing separately",
              "Head of household",
              "Qualifying surviving spouse"
            ]
          }
        }
      ]
    },
