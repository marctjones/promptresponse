      "prompts": [
        {
          "id": "other-income-not-from-jobs-if-you-want-tax-withh",
          "label": "Other income (not from jobs). If you want tax withheld for other income you expect this year that won't have withholding, enter the amount of other income here. This may include interest, dividends, and retirement income",
