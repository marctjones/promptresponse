    {
      "id": "step-4-b-deductions-worksheet",
      "title": "Step 4(b) \u2014 Deductions Worksheet",
      "prompts": [
        {
          "id": "deductions-for-qualified-tips-overtime-compensation-and-passenger-vehicle-loan-interest",
          "label": "Deductions for qualified tips, overtime compensation, and passenger vehicle loan interest.",
          "response": "",
          "hints": {
            "expectedDataType": "number"
          }
        },
        {
          "id": "a-qualified-tips-if-your-total-income-is-less-than-150-000-300-000-if-married-filing-jointly-enter-an-estimate-of-your-qualified-tips-up-to-25-000",
          "label": "a Qualified tips. If your total income is less than $150,000 ($300,000 if married filing jointly), enter an estimate of your qualified tips up to $25,000",
          "response": "",
          "hints": {
            "expectedDataType": "number"
          }
        },
        {
          "id": "b-qualified-overtime-compensation-if-your-total-income-is-less-than-150-000-300-000-if-married-filing-jointly-enter-an-estimate-of-your-qualified-overtime-compensation-up-to-12-500-25-000-if-married-filing-jointly-of-the-and-a-half-portion-of-time-and-a-half-compensation",
          "label": "b Qualified overtime compensation. If your total income is less than $150,000 ($300,000 if married filing jointly), enter an estimate of your qualified overtime compensation up to $12,500 ($25,000 if married filing jointly) of the \u201cand-a-half\u201d portion of time-and-a-half compensation",
          "response": "",
          "hints": {
            "expectedDataType": "number"
          }
        },
        {
          "id": "c-qualified-passenger-vehicle-loan-interest-if-your-total-income-is-less-than-100-000-200-000-if-married-filing-jointly-enter-an-estimate-of-your-qualified-passenger-vehicle-loan-interest-up-to-10-000",
          "label": "c Qualified passenger vehicle loan interest. If your total income is less than $100,000 ($200,000 if married filing jointly), enter an estimate of your qualified passenger vehicle loan interest up to $10,000",
          "response": "",
          "hints": {
            "expectedDataType": "number"
          }
        },
        {
          "id": "add-lines-1a-1b-and-1c-enter-the-result-here",
          "label": "Add lines 1a, 1b, and 1c. Enter the result here",
          "response": "",
          "hints": {
            "expectedDataType": "number"
          }
        },
        {
