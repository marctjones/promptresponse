        {
          "id": "enter-an-estimate-of-your-student-loan-interest-deductible-ira-contributions-educator-expenses-alimony-paid-and-certain-other-adjustments-from-schedule-1-form-1040-part-ii-see-pub-505-for-more-information",
          "label": "Enter an estimate of your student loan interest, deductible IRA contributions, educator expenses, alimony paid, and certain other adjustments from Schedule 1 (Form 1040), Part II. See Pub. 505 for more information",
          "response": "",
          "hints": {
            "expectedDataType": "number"
