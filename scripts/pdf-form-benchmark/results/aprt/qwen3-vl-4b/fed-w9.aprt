  "sections": [
    {
      "id": "part-i-taxpayer-identification-number-tin",
      "title": "Part I Taxpayer Identification Number (TIN)",
      "prompts": [
        {
          "id": "name-of-entity-individual-an-entry-is-required-for-a-sole-proprietor-or-disregarded-entity-enter-the-owner-s-name-on-line-1-and-enter-the-business-disregarded-entity-s-name-on-line-2",
          "label": "Name of entity/individual. An entry is required. (For a sole proprietor or disregarded entity, enter the owner\u2019s name on line 1, and enter the business/disregarded entity\u2019s name on line 2.)",
          "response": "",
          "hints": {
            "expectedDataType": "text"
          }
        },
        {
          "id": "business-name-disregarded-entity-name-if-different-from-above",
          "label": "Business name/disregarded entity name, if different from above.",
          "response": "",
          "hints": {
            "expectedDataType": "text"
          }
        },
        {
          "id": "check-the-appropriate-box-for-federal-tax-classification-of-the-entity-individual-whose-name-is-entered-on-line-1-check-only-one-of-the-following-seven-boxes",
          "label": "Check the appropriate box for federal tax classification of the entity/individual whose name is entered on line 1. Check only one of the following seven boxes.",
          "response": "",
          "hints": {
            "expectedDataType": "boolean",
            "suggestedValues": [
              "Individual/sole proprietor",
              "C corporation",
              "S corporation",
              "Partnership",
              "Trust/estate",
              "LLC",
              "Other (see instructions)"
            ]
          }
        },
        {
          "id": "if-on-line-3a-you-checked-partnership-or-trust-estate-or-checked-llc-and-entered-p-as-its-tax-classification-and-you-are-providing-this-form-to-a-partnership-trust-or-estate-in-which-you-have-an-ownership-interest-check-this-box-if-you-have-any-foreign-partners-owners-or-beneficiaries",
          "label": "If on line 3a you checked \u201cPartnership\u201d or \u201cTrust/estate,\u201d or checked \u201cLLC\u201d and entered \u201cP\u201d as its tax classification, and you are providing this form to a partnership, trust, or estate in which you have an ownership interest, check this box if you have any foreign partners, owners, or beneficiaries",
          "response": "",
          "hints": {
            "expectedDataType": "boolean"
          }
        },
