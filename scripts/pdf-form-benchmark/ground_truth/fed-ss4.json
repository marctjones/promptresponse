{
  "form_id": "fed-ss4",
  "form_name": "IRS Form SS-4 (Application for Employer Identification Number)",
  "page_count": 2,
  "sections": [
    {"id": "entity-information", "title": "Entity Information (lines 1-9b)"},
    {"id": "application-details", "title": "Application Details (lines 10-18)"},
    {"id": "third-party-designee", "title": "Third Party Designee"},
    {"id": "certification", "title": "Certification / Signature"}
  ],
  "fields": [
    {"id": "legal-name", "label": "1 Legal name of entity (or individual) for whom the EIN is being requested", "expected_data_type": "text", "required": true, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "trade-name", "label": "2 Trade name of business (if different from name on line 1)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "care-of-name", "label": "3 Executor, administrator, trustee, \"care of\" name", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "mailing-address", "label": "4a Mailing address (room, apt., suite no. and street, or P.O. box)", "expected_data_type": "text", "required": true, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "mailing-city-state-zip", "label": "4b City, state, and ZIP code (if foreign, see instructions)", "expected_data_type": "text", "required": true, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "street-address-different", "label": "5a Street address (if different) (Don't enter a P.O. box.)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "street-city-state-zip", "label": "5b City, state, and ZIP code (if foreign, see instructions)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "county-state", "label": "6 County and state where principal business is located", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "responsible-party-name", "label": "7a Name of responsible party", "expected_data_type": "text", "required": true, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "responsible-party-tin", "label": "7b SSN, ITIN, or EIN", "expected_data_type": "text", "required": true, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "llc-application", "label": "8a Is this application for a limited liability company (LLC) (or a foreign equivalent)?", "expected_data_type": "boolean", "required": true, "section_id": "entity-information", "field_kind": "choice", "choices": ["Yes", "No"]},
    {"id": "llc-members-count", "label": "8b If 8a is \"Yes,\" enter the number of LLC members", "expected_data_type": "number", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Conditional on 8a = Yes."},
    {"id": "llc-organized-us", "label": "8c If 8a is \"Yes,\" was the LLC organized in the United States?", "expected_data_type": "boolean", "required": false, "section_id": "entity-information", "field_kind": "choice", "choices": ["Yes", "No"], "notes": "Conditional on 8a = Yes."},
    {
      "id": "entity-type",
      "label": "9a Type of entity (check only one box)",
      "expected_data_type": "text",
      "required": true,
      "section_id": "entity-information",
      "field_kind": "choice",
      "choices": ["Sole proprietor (SSN)", "Partnership", "Corporation (enter form number to be filed)", "Personal service corporation", "Church or church-controlled organization", "Other nonprofit organization (specify)", "Other (specify)", "Estate (SSN of decedent)", "Plan administrator (TIN)", "Trust (TIN of grantor)", "Military/National Guard", "State/local government", "Farmers' cooperative", "Federal government", "REMIC", "Indian tribal governments/enterprises"]
    },
    {"id": "sole-proprietor-ssn", "label": "Sole proprietor (SSN)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank next to the 'Sole proprietor' box in line 9a; conditional on that box being checked."},
    {"id": "corporation-form-number", "label": "Corporation (enter form number to be filed)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank in line 9a; conditional on the 'Corporation' box being checked."},
    {"id": "other-nonprofit-specify", "label": "Other nonprofit organization (specify)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank in line 9a; conditional."},
    {"id": "other-entity-specify", "label": "Other (specify)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank in line 9a for the generic 'Other' entity-type box; conditional. Label text duplicates other 'Other (specify)' write-ins elsewhere on the form (line 10, line 16) -- disambiguate by section position."},
    {"id": "estate-ssn-decedent", "label": "Estate (SSN of decedent)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank in line 9a; conditional."},
    {"id": "plan-administrator-tin", "label": "Plan administrator (TIN)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank in line 9a; conditional."},
    {"id": "trust-tin-grantor", "label": "Trust (TIN of grantor)", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "Write-in blank in line 9a; conditional."},
    {"id": "group-exemption-number", "label": "Group Exemption Number (GEN) if any", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line"},
    {"id": "incorporation-state", "label": "9b State", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "If a corporation, name the state where incorporated; conditional on entity type."},
    {"id": "incorporation-foreign-country", "label": "9b Foreign country", "expected_data_type": "text", "required": false, "section_id": "entity-information", "field_kind": "text_line", "notes": "If a corporation, name the foreign country where incorporated; conditional on entity type."},

    {
      "id": "reason-for-applying",
      "label": "10 Reason for applying (check only one box)",
      "expected_data_type": "text",
      "required": true,
      "section_id": "application-details",
      "field_kind": "choice",
      "choices": ["Started new business (specify type)", "Hired employees (Check the box and see line 13.)", "Compliance with IRS withholding regulations", "Other (specify)", "Purchased going business", "Changed type of organization (specify new type)", "Created a trust (specify type)", "Created a pension plan (specify type)", "Banking purpose (specify purpose)"]
    },
    {"id": "new-business-type", "label": "Started new business (specify type)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 10; conditional."},
    {"id": "reason-other-specify", "label": "Other (specify)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 10 for the generic 'Other' reason box; conditional. Duplicate label text of other 'Other (specify)' write-ins on this form -- disambiguate by section position."},
    {"id": "changed-org-new-type", "label": "Changed type of organization (specify new type)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 10; conditional."},
    {"id": "trust-type-created", "label": "Created a trust (specify type)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 10; conditional."},
    {"id": "pension-plan-type", "label": "Created a pension plan (specify type)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 10; conditional."},
    {"id": "banking-purpose", "label": "Banking purpose (specify purpose)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 10; conditional."},
    {"id": "date-business-started", "label": "11 Date business started or acquired (month, day, year). See instructions.", "expected_data_type": "date", "required": true, "section_id": "application-details", "field_kind": "date_field"},
    {"id": "closing-month-accounting-year", "label": "12 Closing month of accounting year", "expected_data_type": "text", "required": true, "section_id": "application-details", "field_kind": "text_line"},
    {"id": "employees-agricultural", "label": "13 Highest number of employees expected in the next 12 months (enter -0- if none) -- Agricultural", "expected_data_type": "number", "required": true, "section_id": "application-details", "field_kind": "text_line"},
    {"id": "employees-household", "label": "13 Highest number of employees expected in the next 12 months (enter -0- if none) -- Household", "expected_data_type": "number", "required": true, "section_id": "application-details", "field_kind": "text_line"},
    {"id": "employees-other", "label": "13 Highest number of employees expected in the next 12 months (enter -0- if none) -- Other", "expected_data_type": "number", "required": true, "section_id": "application-details", "field_kind": "text_line"},
    {"id": "form-944-election-checkbox", "label": "14 If you expect your employment tax liability to be $1,000 or less in a full calendar year and want to file Form 944 annually instead of Forms 941 quarterly, check here.", "expected_data_type": "boolean", "required": false, "section_id": "application-details", "field_kind": "checkbox"},
    {"id": "first-wages-paid-date", "label": "15 First date wages or annuities were paid (month, day, year).", "expected_data_type": "date", "required": false, "section_id": "application-details", "field_kind": "date_field", "notes": "Skippable if no employees expected (see line 13 instruction)."},
    {
      "id": "principal-activity",
      "label": "16 Check one box that best describes the principal activity of your business.",
      "expected_data_type": "text",
      "required": true,
      "section_id": "application-details",
      "field_kind": "choice",
      "choices": ["Construction", "Real estate", "Rental & leasing", "Manufacturing", "Transportation & warehousing", "Finance & insurance", "Health care & social assistance", "Accommodation & food service", "Wholesale—agent/broker", "Wholesale—other", "Retail", "Other (specify)"]
    },
    {"id": "principal-activity-other-specify", "label": "Other (specify)", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Write-in blank in line 16 for the generic 'Other' activity box; conditional. Duplicate label text of other 'Other (specify)' write-ins on this form -- disambiguate by section position."},
    {"id": "principal-line-merchandise", "label": "17 Indicate principal line of merchandise sold, specific construction work done, products produced, or services provided.", "expected_data_type": "text", "required": null, "section_id": "application-details", "field_kind": "text_line"},
    {"id": "prior-ein-applied", "label": "18 Has the applicant entity shown on line 1 ever applied for and received an EIN?", "expected_data_type": "boolean", "required": true, "section_id": "application-details", "field_kind": "choice", "choices": ["Yes", "No"]},
    {"id": "previous-ein", "label": "If \"Yes,\" write previous EIN here", "expected_data_type": "text", "required": false, "section_id": "application-details", "field_kind": "text_line", "notes": "Conditional on line 18 = Yes."},

    {"id": "designee-name", "label": "Designee's name", "expected_data_type": "text", "required": false, "section_id": "third-party-designee", "field_kind": "text_line", "notes": "Entire Third Party Designee section is optional: 'Complete this section only if you want to authorize...'"},
    {"id": "designee-phone", "label": "Designee's telephone number (include area code)", "expected_data_type": "phone", "required": false, "section_id": "third-party-designee", "field_kind": "text_line"},
    {"id": "designee-address-zip", "label": "Address and ZIP code", "expected_data_type": "text", "required": false, "section_id": "third-party-designee", "field_kind": "text_line"},
    {"id": "designee-fax", "label": "Designee's fax number (include area code)", "expected_data_type": "phone", "required": false, "section_id": "third-party-designee", "field_kind": "text_line"},

    {"id": "name-and-title", "label": "Name and title (type or print clearly)", "expected_data_type": "text", "required": true, "section_id": "certification", "field_kind": "text_line"},
    {"id": "applicant-phone", "label": "Applicant's telephone number (include area code)", "expected_data_type": "phone", "required": true, "section_id": "certification", "field_kind": "text_line"},
    {"id": "signature", "label": "Signature", "expected_data_type": "text", "required": true, "section_id": "certification", "field_kind": "signature"},
    {"id": "certification-date", "label": "Date", "expected_data_type": "date", "required": true, "section_id": "certification", "field_kind": "date_field"},
    {"id": "applicant-fax", "label": "Applicant's fax number (include area code)", "expected_data_type": "phone", "required": false, "section_id": "certification", "field_kind": "text_line"}
  ]
}
