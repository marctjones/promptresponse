    {
      "id": "ct-dmv-a25-flat",
      "name": "Connecticut DMV Form A-25, scanned original with its widgets removed",
      "jurisdiction": "connecticut",
      "agency": "DMV",
      "derivedFrom": "ct-dmv-a25",
      "synthesis": "flatten",
      "difficulty": "medium",
      "role": "converter-development",
      "hasAcroForm": false,
      "hasTextLayer": false,
      "note": "The source is already a scan (a CCITT G4 bitonal image) with widgets laid over it and no text layer, so removing the widgets leaves a genuine image-only page -- real scanner artifacts included, which no rasterization reproduces. Caveat: the source's CropBox is [0 198 612 585] inside a 612x792 MediaBox, and flattening bakes the CropBox in, so the page origin moves. Its ten source widget Rects need y-198 to line up with this fixture -- the only derived form where the geometry oracle does not transfer unchanged."
    },
