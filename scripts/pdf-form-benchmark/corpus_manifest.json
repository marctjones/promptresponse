    {
      "id": "fed-i9-scan",
      "name": "USCIS Form I-9, printed and scanned",
      "jurisdiction": "federal",
      "agency": "USCIS",
      "derivedFrom": "fed-i9",
      "synthesis": "rasterize",
      "difficulty": "complex",
      "role": "converter-development",
      "hasAcroForm": false,
      "hasTextLayer": false,
      "note": "The image-only case at its hardest: four pages of dense grid layout, and the one form whose 128 fields all carry the author's own /TU text, so the source's tooltips remain a mechanical answer key even for a page that is nothing but pixels. Clean 150 DPI bitonal -- no skew or speckle."
    },
    {
      "id": "ct-w4-flat",
      "name": "Connecticut Form CT-W4, printed to a flat PDF",
      "jurisdiction": "connecticut",
      "agency": "DRS",
      "derivedFrom": "ct-w4",
      "synthesis": "flatten",
      "difficulty": "medium",
      "role": "converter-development",
      "hasAcroForm": false,
      "hasTextLayer": true,
      "note": "One of only two corpus forms whose widgets draw anything at all beyond the page content. What they draw is the JavaScript 'Print Form' and 'Clear Fields' push-buttons plus a few checkbox glyphs, so this fixture is the one that exercises widget-supplied content: flattening correctly keeps the checkboxes and correctly loses the buttons, which is why it retains 99.75% of its source's words rather than 100%."
    },
