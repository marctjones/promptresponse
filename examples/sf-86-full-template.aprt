{
  "version": "1.0",
  "documentType": "template",
  "metadata": {
    "title": "SF-86 Questionnaire for National Security Positions",
    "description": "Standard Form 86 - Complete questionnaire used for background investigations for national security positions. OMB Control Number 3206-0005. This form is used by the United States Government in conducting background investigations, reinvestigations, and continuous evaluations of persons under consideration for, or retention of, national security positions.",
    "templateId": "sf-86-full-v1.0",
    "templateVersion": "1.0.0",
    "created": "2025-01-13T00:00:00Z",
    "modified": "2025-01-13T00:00:00Z",
    "author": "U.S. Office of Personnel Management (OPM)",
    "organization": "U.S. Government"
  },
  "sections": [
    {
      "id": "section_intro",
      "title": "Introduction and Instructions",
      "description": "Read these instructions carefully before completing the form. The U.S. Government is authorized to ask for this information under Executive Orders 10450, 10865, 12333, and 12968; sections 3301, 3302, and 9101 of title 5, United States Code; section 2165 of title 42, United States Code; and sections 2, 3, and 5 of the Act of August 9, 1950, as amended (50 U.S.C. 831-835).",
      "prompts": [
        {
          "id": "intro_001",
          "label": "I have read and understood the Purpose of this Form",
          "response": "",
          "hints": {
            "helpText": "This questionnaire is used to determine eligibility for access to classified information or to hold a sensitive position. The information you provide will be used in a background investigation.",
            "expectedDataType": "boolean",
            "placeholder": "Yes/No"
          }
        },
        {
          "id": "intro_002",
          "label": "I understand that withholding, misrepresenting, or falsifying information may affect my eligibility",
          "response": "",
          "hints": {
            "helpText": "A knowing and willful false statement on this form can be punished by fine or imprisonment or both (See section 1001 of title 18, United States Code).",
            "expectedDataType": "boolean",
            "placeholder": "Yes/No"
          }
        }
      ],
      "subsections": []
    },
    {
      "id": "section_01_07",
      "title": "Sections 1-7: Identifying Information",
      "description": "Provide your full legal name, date of birth, place of birth, Social Security Number, and other identifying information.",
      "prompts": [],
      "subsections": [
        {
          "id": "section_01",
          "title": "Section 1: Full Name",
          "description": "Enter your full legal name as it appears on your birth certificate or other legal documents.",
          "prompts": [
            {
              "id": "s01_last_name",
              "label": "Last Name (Family Name)",
              "response": "",
              "hints": {
                "expectedDataType": "text",
                "helpText": "Your last name or family name"
              }
            },
            {
              "id": "s01_first_name",
              "label": "First Name (Given Name)",
              "response": "",
              "hints": {
                "expectedDataType": "text",
                "helpText": "Your first name or given name"
              }
            },
            {
              "id": "s01_middle_name",
              "label": "Middle Name(s)",
              "response": "",
              "hints": {
                "expectedDataType": "text",
                "helpText": "Your middle name(s), if applicable"
              }
            },
            {
              "id": "s01_suffix",
              "label": "Suffix",
              "response": "",
              "hints": {
                "expectedDataType": "text",
                "placeholder": "Jr., Sr., III, etc.",
                "helpText": "Name suffix, if applicable"
              }
            },
            {
              "id": "s01_other_names",
              "label": "Have you used any other names?",
              "response": "",
              "hints": {
                "expectedDataType": "boolean",
                "placeholder": "Yes/No"
              }
            },
            {
              "id": "s01_other_names_list",
              "label": "List all other names used (maiden, former married, aliases, nicknames)",
              "response": "",
              "hints": {
                "expectedDataType": "multiline",
                "helpText": "Include maiden names, former married names, aliases, and nicknames. Provide dates used."
              }
            }
          ]
        },
        {
