{
  "documentType": "template",
  "metadata": {
    "title": "Field Type Hints Demonstration",
    "description": "Demonstrates various field type hints available in PromptResponse. These hints are advisory only and do not enforce validation - users can always enter any text.",
    "templateVersion": "1.0.0",
    "created": "2025-11-13T00:00:00Z",
    "modified": "2025-11-13T00:00:00Z"
  },
  "sections": [
    {
      "id": "contact_information",
      "title": "Contact Information",
      "description": "Common contact field types",
      "prompts": [
        {
          "id": "full_name",
          "label": "Full Name",
          "hints": {
            "expectedDataType": "text",
            "placeholder": "John Doe",
            "helpText": "Enter your full legal name"
          }
        },
        {
          "id": "email_address",
          "label": "Email Address",
          "hints": {
            "expectedDataType": "email",
            "placeholder": "name@example.com",
            "helpText": "We'll use this for communication"
          }
        },
        {
          "id": "phone_number",
          "label": "Phone Number",
          "hints": {
            "expectedDataType": "phone",
            "placeholder": "+1-555-0100",
            "helpText": "Include country code if applicable"
          }
        },
        {
          "id": "website",
          "label": "Website",
          "hints": {
            "expectedDataType": "url",
            "placeholder": "https://example.com",
            "helpText": "Your personal or business website (optional)"
          }
        }
      ],
      "subsections": []
    },
    {
      "id": "dates_and_times",
      "title": "Dates and Times",
      "description": "Various date and time field types",
      "prompts": [
        {
          "id": "birth_date",
          "label": "Date of Birth",
          "hints": {
            "expectedDataType": "date",
            "placeholder": "YYYY-MM-DD",
            "helpText": "Enter date in YYYY-MM-DD format (e.g., 1990-01-31)",
            "validationPattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        {
          "id": "appointment_time",
          "label": "Preferred Appointment Time",
          "hints": {
            "expectedDataType": "time",
            "placeholder": "HH:MM",
            "helpText": "24-hour format (e.g., 14:30)"
          }
        },
        {
          "id": "event_datetime",
          "label": "Event Date and Time",
          "hints": {
            "expectedDataType": "datetime",
            "placeholder": "YYYY-MM-DD HH:MM",
            "helpText": "Full date and time (e.g., 2025-12-31 23:59)"
          }
        }
      ],
      "subsections": []
    },
    {
      "id": "numeric_fields",
      "title": "Numeric Fields",
      "description": "Number and currency field types",
      "prompts": [
        {
          "id": "age",
          "label": "Age",
          "hints": {
            "expectedDataType": "number",
            "placeholder": "25",
            "helpText": "Your age in years"
          }
        },
        {
          "id": "annual_income",
          "label": "Annual Income",
          "hints": {
            "expectedDataType": "currency",
            "placeholder": "$50,000",
            "helpText": "Approximate annual income before taxes"
          }
        },
        {
          "id": "percentage",
          "label": "Completion Percentage",
          "hints": {
            "expectedDataType": "number",
            "placeholder": "75",
            "helpText": "Enter a number between 0 and 100"
          }
        }
      ],
      "subsections": []
    },
    {
      "id": "text_fields",
      "title": "Text Fields",
      "description": "Different text input types",
      "prompts": [
        {
          "id": "short_answer",
          "label": "Favorite Color",
          "hints": {
            "expectedDataType": "text",
            "placeholder": "Blue",
            "helpText": "One word answer"
          }
        },
        {
          "id": "long_answer",
          "label": "Tell Us About Yourself",
          "hints": {
            "expectedDataType": "multiline",
            "placeholder": "Write a brief description...",
            "helpText": "Feel free to write as much as you'd like"
          }
        }
      ],
      "subsections": []
    },
    {
      "id": "choices_and_options",
      "title": "Choices and Options",
      "description": "Fields with choice, multichoice, and boolean types",
      "prompts": [
        {
          "id": "country",
          "label": "Country",
          "hints": {
            "expectedDataType": "choice",
            "placeholder": "Select a country",
            "helpText": "Select from dropdown (6+ options shows as dropdown)",
            "suggestedValues": [
              "United States",
              "Canada",
              "United Kingdom",
              "Australia",
              "Germany",
              "France",
              "Japan"
            ]
          }
        },
        {
          "id": "preferred_contact",
          "label": "Preferred Contact Method",
          "hints": {
            "expectedDataType": "choice",
            "placeholder": "Select contact method",
            "helpText": "Radio buttons shown for 2-5 options",
            "suggestedValues": [
              "Email",
              "Phone",
              "Text Message",
              "Mail"
            ]
          }
        },
        {
          "id": "interests",
          "label": "Areas of Interest",
          "hints": {
            "expectedDataType": "multichoice",
            "helpText": "Select all that apply (checkboxes for multiple selection)",
            "suggestedValues": [
              "Technology",
              "Finance",
              "Healthcare",
              "Education",
              "Arts & Entertainment",
              "Sports & Recreation"
            ]
          }
        },
        {
          "id": "newsletter_subscription",
          "label": "Subscribe to Newsletter",
          "hints": {
            "expectedDataType": "boolean",
            "helpText": "Check to receive monthly updates"
          }
        },
        {
          "id": "terms_agreement",
          "label": "I agree to the Terms and Conditions",
          "hints": {
            "expectedDataType": "boolean",
            "helpText": "You must agree to continue"
          }
        }
      ],
      "subsections": []
    }
  ]
}
