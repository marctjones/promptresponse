{
  "version": "1.0",
  "documentType": "template",
  "metadata": {
    "title": "Field Types Showcase - APR Format Demo",
    "description": "A comprehensive demonstration of all supported field types, hints, validation patterns, and form features in the APR format",
    "created": "2025-01-01T00:00:00Z",
    "modified": "2025-01-01T00:00:00Z",
    "author": "PromptResponse Team",
    "templateId": "field-types-showcase",
    "templateVersion": "1.0"
  },
  "sections": [
    {
      "id": "section_text_fields",
      "title": "Text Input Fields",
      "description": "Various text-based input types",
      "prompts": [
        {
          "id": "prompt_text_basic",
          "label": "Basic Text Field",
          "response": "",
          "hints": {
            "placeholder": "Enter any text here",
            "expectedDataType": "text",
            "helpText": "A simple single-line text input for general text entry"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_text_multiline",
          "label": "Multi-line Text (Comments/Description)",
          "response": "",
          "hints": {
            "placeholder": "Enter multiple lines of text...\nPress Enter for new lines",
            "expectedDataType": "multiline",
            "helpText": "Use this for longer text entries like comments, descriptions, or addresses"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_text_with_validation",
          "label": "Text with Validation Pattern (Product Code)",
          "response": "",
          "hints": {
            "placeholder": "ABC-12345",
            "expectedDataType": "text",
            "validationPattern": "^[A-Z]{3}-\\d{5}$",
            "helpText": "Format: 3 uppercase letters, hyphen, 5 digits (e.g., ABC-12345)"
          },
          "responseMetadata": {}
        }
      ]
    },
    {
