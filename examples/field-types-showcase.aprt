    {
      "id": "section_tables",
      "title": "Table Fields",
      "description": "Demonstrating fixed and dynamic table data entry",
      "prompts": [
        {
          "id": "prompt_table_fixed",
          "label": "Income by Tax Year (Fixed Table)",
          "response": "",
          "hints": {
            "expectedDataType": "table",
            "helpText": "Enter income data for each tax year. Rows are fixed - you cannot add or remove years.",
            "tableDefinition": {
              "columns": [
                { "id": "wages", "label": "Wages & Salary", "type": "currency", "placeholder": "0.00" },
                { "id": "interest", "label": "Interest Income", "type": "currency", "placeholder": "0.00" },
                { "id": "dividends", "label": "Dividend Income", "type": "currency", "placeholder": "0.00" },
                { "id": "other", "label": "Other Income", "type": "currency", "placeholder": "0.00" }
              ],
              "fixedRows": [
                { "id": "year_2024", "label": "2024" },
                { "id": "year_2023", "label": "2023" },
                { "id": "year_2022", "label": "2022" }
              ]
            }
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_table_dynamic",
          "label": "Order Line Items (Dynamic Table)",
          "response": "",
          "hints": {
            "expectedDataType": "table",
            "helpText": "Add items to your order. You can add up to 20 items.",
            "tableDefinition": {
              "columns": [
                { "id": "item", "label": "Item Description", "type": "text", "placeholder": "Enter item name" },
                { "id": "sku", "label": "SKU", "type": "text", "placeholder": "ABC-123" },
                { "id": "qty", "label": "Qty", "type": "number", "width": "60px" },
                { "id": "price", "label": "Unit Price", "type": "currency", "placeholder": "0.00" }
              ],
              "dynamicRows": {
                "minRows": 1,
                "maxRows": 20,
                "rowLabel": "Item"
              }
            }
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_table_addresses",
          "label": "Previous Addresses (Dynamic Table)",
          "response": "",
          "hints": {
            "expectedDataType": "table",
            "helpText": "List all addresses where you have lived in the past 5 years",
            "tableDefinition": {
              "columns": [
