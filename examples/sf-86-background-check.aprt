    {
      "id": "section_instructions",
      "title": "Instructions and certification (simplified)",
      "description": "The official November 2016 SF-86 begins with multi-page instructions, authority, disclosure, penalties, and privacy information. This demonstration cannot represent those prose-only blocks as standalone APR sections under the frozen format; consult docs/research/sf86-2016-official-extracted.txt and the related comparison report before using it for reference.",
      "prompts": [
        {
          "id": "prompt_investigation_type",
          "label": "Type of Investigation Requested",
          "response": "",
          "hints": {
            "expectedDataType": "text",
            "suggestedValues": [
              "Initial Investigation",
              "Reinvestigation",
              "Upgrade"
            ],
            "helpText": "Select the type of investigation being conducted"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_agency_use",
