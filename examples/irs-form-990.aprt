{
  "version": "1.0-beta.6",
  "documentType": "template",
  "metadata": {
    "title": "IRS Form 990 - Return of Organization Exempt From Income Tax",
    "description": "Annual information return filed by tax-exempt organizations under section 501(c), 527, or 4947(a)(1) of the Internal Revenue Code",
    "created": "2025-01-01T00:00:00Z",
    "modified": "2025-01-01T00:00:00Z",
    "author": "Internal Revenue Service",
    "templateId": "irs-form-990-2024",
    "templateVersion": "2024.1"
  },
  "sections": [
    {
      "id": "section_header",
      "title": "Form Header Information",
      "description": "Basic form identification and tax period",
      "prompts": [
        {
          "id": "prompt_tax_year",
          "label": "Tax Year",
          "response": "",
          "hints": {
            "placeholder": "2024",
            "expectedDataType": "number",
            "helpText": "Calendar year or fiscal year ending date"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_fiscal_year_begin",
          "label": "Fiscal Year Beginning Date",
          "response": "",
          "hints": {
            "placeholder": "2024-01-01",
            "expectedDataType": "date",
            "helpText": "For calendar year filers, enter January 1"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_fiscal_year_end",
          "label": "Fiscal Year Ending Date",
          "response": "",
          "hints": {
            "placeholder": "2024-12-31",
            "expectedDataType": "date",
            "helpText": "For calendar year filers, enter December 31"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_amended_return",
          "label": "Is this an amended return?",
          "response": "",
          "hints": {
            "expectedDataType": "boolean",
            "suggestedValues": [
              "Yes",
              "No"
            ],
            "helpText": "Check if this is an amended return"
          },
          "responseMetadata": {}
        },
        {
          "id": "prompt_application_pending",
          "label": "Is the application for exemption pending?",
          "response": "",
          "hints": {
            "expectedDataType": "boolean",
            "suggestedValues": [
              "Yes",
              "No"
            ]
          },
          "responseMetadata": {}
        }
      ]
    },
