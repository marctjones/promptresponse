<Project>

  <!--
    Centralized build settings for all PromptResponse projects.
    Project-level .csproj files inherit these and may override individual properties when needed.
  -->

  <PropertyGroup>
    <!-- Language and runtime -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: warnings are errors so CI fails on regressions. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>

    <!--
      NU1903: Tmds.DBus 0.15.0 has a known high-severity vulnerability flagged by NuGet.
      It's a transitive dependency of Avalonia's Linux platform layer; tracked separately for upgrade.
      Suppress the build-time warning so CI stays green until the dependency tree updates.
    -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>

    <!-- Deterministic build for reproducibility -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
