<Project>

  <!--
    Centralized build settings for all PromptResponse projects.
    Project-level .csproj files inherit these and may override individual properties when needed.
  -->

  <PropertyGroup>
    <!-- Language and runtime -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Stable C# (14, shipped with the .NET 10 SDK); not 'preview' (unreleased features). -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: warnings are errors so CI fails on regressions. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>

    <!-- Deterministic build for reproducibility -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
